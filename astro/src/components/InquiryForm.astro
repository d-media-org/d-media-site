---
import {
  contactBudgetLabelsBg,
  contactBudgets,
  contactFieldLimits,
  contactServiceLabelsBg,
  contactServices,
} from "@/lib/contact-inquiry";

type Props = { locale: "bg" | "en" };
const { locale } = Astro.props as Props;
const isBg = locale === "bg";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAADpL5PXvzZD7h9GA";
const estimator = Astro.url.searchParams.get("estimator") === "1";
const estimatorData = {
  services: Astro.url.searchParams.get("services") ?? "",
  serviceValues: Astro.url.searchParams.get("serviceValues") ?? "",
  goal: Astro.url.searchParams.get("goal") ?? "",
  scope: Astro.url.searchParams.get("scope") ?? "",
  complexity: Astro.url.searchParams.get("complexity") ?? "",
  timeline: Astro.url.searchParams.get("timeline") ?? "",
  estimatedRange: Astro.url.searchParams.get("estimatedRange") ?? "",
  extras: Astro.url.searchParams.get("extras") ?? "",
  budget: Astro.url.searchParams.get("budget") ?? "",
  recommendations: Astro.url.searchParams.get("recommendations") ?? "",
  readinessScore: Astro.url.searchParams.get("readinessScore") ?? "",
  leadScore: Astro.url.searchParams.get("leadScore") ?? "",
  confidence: Astro.url.searchParams.get("confidence") ?? "",
  brief: Astro.url.searchParams.get("brief") ?? "",
};

const copy = isBg
  ? {
      title: "Проектно запитване",
      intro: "Изпрати кратък контекст и ще върнем яснота за обхват, срок и следваща стъпка.",
      formTitle: "Изпрати запитване",
      name: "Име",
      email: "E-mail",
      company: "Фирма",
      service: "Услуга",
      message: "Съобщение",
      budget: "Ориентировъчен бюджет",
      deadline: "Желан срок",
      website: "Съществуващ сайт",
      additional: "Допълнителна информация",
      consent: "Съгласявам се информацията ми да бъде използвана за отговор на моето запитване.",
      submit: "Изпрати запитване",
      success: "Запитването е изпратено успешно. Ще върнем отговор възможно най-скоро.",
      error: "Възникна грешка. Моля, провери полетата и опитай отново.",
      turnstileError: "Потвърждението против спам не е завършено.",
      required: "задължително поле",
      requiredLegend: "Полетата, отбелязани със звездичка, са задължителни.",
      loading: "Изпращане…",
      validationRequired: "Моля, попълни това поле.",
      validationEmail: "Моля, въведи валиден e-mail адрес.",
      validationWebsite: "Моля, въведи пълен адрес, започващ с https://.",
      validationConsent: "Необходимо е съгласие, за да изпратиш запитването.",
      optional: "по избор",
      messageHint: "Разкажи накратко какъв е проектът и какъв резултат очакваш.",
      estimatorExplanation:
        "Избраните параметри вече са добавени към проектния бриф. Попълнете име, имейл и допълнителна информация, ако има специфични изисквания, които искате да уточните.",
      generatedBrief: "Генериран проектен бриф",
      generatedBriefNote: "Това обобщение ще бъде изпратено автоматично със запитването.",
      additionalHint: "Добавете само контекст, който не присъства в генерирания бриф.",
      privacyLink: "/privacy/",
      privacyText: "За защита на данните",
    }
  : {
      title: "Project inquiry",
      intro: "Send brief context and we will return with scope, timing, and the next step.",
      formTitle: "Send inquiry",
      name: "Name",
      email: "Email",
      company: "Company",
      service: "Service",
      message: "Message",
      budget: "Estimated Budget",
      deadline: "Desired Deadline",
      website: "Existing Website",
      additional: "Additional Information",
      consent: "I agree that my information may be used for the purpose of responding to my inquiry.",
      submit: "Send inquiry",
      success: "The inquiry was sent successfully. We will reply as soon as possible.",
      error: "An error occurred. Please review the fields and try again.",
      turnstileError: "The anti-spam confirmation is incomplete.",
      required: "required field",
      requiredLegend: "Fields marked with an asterisk are required.",
      loading: "Sending…",
      validationRequired: "Please complete this field.",
      validationEmail: "Please enter a valid email address.",
      validationWebsite: "Please enter a complete address beginning with https://.",
      validationConsent: "Consent is required to send the inquiry.",
      optional: "optional",
      messageHint: "Briefly describe the project and the result you want.",
      estimatorExplanation:
        "Your selected parameters have already been added to the project brief. Add your name, email, and any additional context or specific requirements you would like to clarify.",
      generatedBrief: "Generated project brief",
      generatedBriefNote: "This summary will be sent automatically with your inquiry.",
      additionalHint: "Add only context that is not already included in the generated brief.",
      privacyLink: "/en/privacy/",
      privacyText: "Data protection",
    };
---

<section class="card inquiry-card" aria-labelledby="inquiry-form-title">
  <div class="inquiry-card-header">
    <p class="eyebrow">{copy.title}</p>
    <h2 id="inquiry-form-title">{copy.formTitle}</h2>
    <p class="page-text">{copy.intro}</p>
    <p class="estimator-form-explanation" data-estimator-only hidden>{copy.estimatorExplanation}</p>
    <p class="form-required-note"><span aria-hidden="true">*</span> {copy.requiredLegend}</p>
  </div>

  <form
    class="inquiry-form"
    method="post"
    action="/api/contact"
    data-inquiry-form
    data-success-message={copy.success}
    data-error-message={copy.error}
    data-turnstile-error={copy.turnstileError}
    data-loading-message={copy.loading}
    data-validation-required={copy.validationRequired}
    data-validation-email={copy.validationEmail}
    data-validation-website={copy.validationWebsite}
    data-validation-consent={copy.validationConsent}
  >
    <div class="form-grid">
      <label class="field">
        <span class="field-label">{copy.name} <span class="field-required" aria-label={copy.required}>*</span></span>
        <input name="name" type="text" autocomplete="name" maxlength={contactFieldLimits.name} required />
      </label>

      <label class="field">
        <span class="field-label">{copy.email} <span class="field-required" aria-label={copy.required}>*</span></span>
        <input name="email" type="email" autocomplete="email" maxlength={contactFieldLimits.email} required />
      </label>

      <label class:list={["field", { "estimator-locked-field": estimator }]}>
        <span class="field-label">{copy.company} <span class="field-meta">{copy.optional}</span></span>
        <input name="company" type="text" autocomplete="organization" maxlength={contactFieldLimits.company} />
      </label>

      <label class:list={["field", { "estimator-locked-field": estimator }]}>
        <span class="field-label">{copy.service} <span class="field-required" aria-label={copy.required}>*</span></span>
        <select name="service" required>
          <option value="">{isBg ? "Избери услуга" : "Select service"}</option>
          {contactServices.map((service) => <option value={service}>{isBg ? contactServiceLabelsBg[service] : service}</option>)}
        </select>
      </label>

      <label class:list={["field", "field-full", { "estimator-locked-field": estimator }]}>
        <span class="field-label">{copy.message} <span class="field-required" aria-label={copy.required}>*</span></span>
        <textarea name="message" rows="6" maxlength={contactFieldLimits.message} required>{estimator ? (isBg ? `Проектен ориентир:\nУслуги: ${estimatorData.services}\nОбхват: ${estimatorData.scope}\nСложност: ${estimatorData.complexity}\nСрок: ${estimatorData.timeline}\nОриентировъчна инвестиция: ${estimatorData.estimatedRange}` : `Project estimate:\nServices: ${estimatorData.services}\nScope: ${estimatorData.scope}\nComplexity: ${estimatorData.complexity}\nTimeline: ${estimatorData.timeline}\nEstimated investment: ${estimatorData.estimatedRange}`) : ""}</textarea>
        <span class="field-hint">{copy.messageHint}</span>
      </label>

        <section class="generated-brief" aria-labelledby="generated-brief-title" data-estimator-only hidden>
          <div class="generated-brief-header">
            <h3 id="generated-brief-title">{copy.generatedBrief}</h3>
            <p>{copy.generatedBriefNote}</p>
          </div>
          <dl class="generated-brief-list">
            <div><dt>{isBg ? "Тип проект" : "Project type"}</dt><dd data-brief-goal>—</dd></div>
            <div><dt>{isBg ? "Услуги" : "Services"}</dt><dd data-brief-services>—</dd></div>
            <div><dt>{isBg ? "Обхват" : "Scope"}</dt><dd data-brief-scope>—</dd></div>
            <div><dt>{isBg ? "Срок" : "Timeline"}</dt><dd data-brief-timeline>—</dd></div>
            <div><dt>{isBg ? "Бюджет" : "Budget"}</dt><dd data-brief-budget>—</dd></div>
            <div><dt>{isBg ? "Ориентир" : "Estimate"}</dt><dd data-brief-estimate>—</dd></div>
            <div class="generated-brief-wide" data-brief-recommendations-row hidden><dt>{isBg ? "Препоръки" : "Recommendations"}</dt><dd data-brief-recommendations></dd></div>
          </dl>
        </section>
      <details class="brief-details" data-standard-brief>
        <summary>{isBg ? "Проектен бриф" : "Project brief"}</summary>
        <div class="brief-grid">
          <label class="field">
            <span class="field-label">{copy.budget}</span>
            <select name="budget">
              <option value="">{isBg ? "Избери бюджет" : "Select budget"}</option>
              {contactBudgets.map((budget) => <option value={budget}>{isBg ? contactBudgetLabelsBg[budget] : budget}</option>)}
            </select>
          </label>
          <label class="field">
            <span class="field-label">{copy.deadline}</span>
            <input name="deadline" type="text" maxlength={contactFieldLimits.deadline} placeholder={isBg ? "например: края на юли" : "for example: end of July"} />
          </label>
          <label class="field">
            <span class="field-label">{copy.website}</span>
            <input name="website" type="url" inputmode="url" maxlength={contactFieldLimits.website} placeholder="https://..." />
          </label>
          <label class="field field-full">
            <span class="field-label">{copy.additional}</span>
            <textarea name="additionalInformation" rows="4" maxlength={contactFieldLimits.additionalInformation}></textarea>
          </label>
        </div>
      </details>

        <label class="field field-full estimator-additional-field" data-estimator-only hidden>
          <span class="field-label">{copy.additional} <span class="field-meta">{copy.optional}</span></span>
          <textarea name="additionalInformation" rows="5" maxlength={contactFieldLimits.additionalInformation}></textarea>
          <span class="field-hint">{copy.additionalHint}</span>
        </label>

      <label class="field field-consent">
        <input name="gdprConsent" type="checkbox" value="yes" required />
        <span>{copy.consent} <span class="field-required" aria-label={copy.required}>*</span></span>
      </label>

      <div class="turnstile-wrap">
        {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div> : null}
      </div>

      <input name="honeypot" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="inquiry-honeypot" />
      <input name="locale" type="hidden" value={locale} />
      <input name="projectScope" type="hidden" value={estimatorData.scope} />
      <input name="services" type="hidden" value={estimatorData.serviceValues} />
      <input name="goal" type="hidden" value={estimatorData.goal} />
      <input name="complexity" type="hidden" value={estimatorData.complexity} />
      <input name="projectTimeline" type="hidden" value={estimatorData.timeline} />
      <input name="estimatedRange" type="hidden" value={estimatorData.estimatedRange} />
      <input name="budget" type="hidden" value="" data-estimator-budget disabled />
      <input name="readinessScore" type="hidden" value={estimatorData.readinessScore} />
      <input name="leadScore" type="hidden" value={estimatorData.leadScore} />
      <input name="confidence" type="hidden" value={estimatorData.confidence} />
      <input name="recommendations" type="hidden" value={estimatorData.recommendations} />
      <input name="projectBrief" type="hidden" value={estimatorData.brief} />

      <div class="form-actions">
        <button type="submit" class="button button-primary" data-submit-button data-default-label={copy.submit}>{copy.submit}</button>
        <p class="form-note">
          <a class="inline-link" href={copy.privacyLink}>{copy.privacyText}</a>
        </p>
      </div>

      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </div>
  </form>
</section>

{siteKey ? <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> : null}
<script is:inline>
  (() => {
    const form = document.querySelector("[data-inquiry-form]");
    if (!form) return;
    const status = form.querySelector("[data-form-status]");
    const submitButton = form.querySelector("[data-submit-button]");
    const setStatus = (message, isError = false) => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = isError ? "error" : "success";
    };
    const setBusy = (busy) => {
      if (submitButton) {
        submitButton.disabled = busy;
        submitButton.textContent = busy
          ? form.dataset.loadingMessage || submitButton.dataset.defaultLabel
          : submitButton.dataset.defaultLabel;
      }
      form.dataset.busy = busy ? "true" : "false";
    };
    const validationMessage = (control) => {
      if (control.name === "gdprConsent") return form.dataset.validationConsent || "";
      if (control.validity.typeMismatch && control.name === "email") return form.dataset.validationEmail || "";
      if (control.validity.typeMismatch && control.name === "website") return form.dataset.validationWebsite || "";
      return form.dataset.validationRequired || "";
    };
    form.querySelectorAll("input, select, textarea").forEach((control) => {
      control.addEventListener("invalid", () => control.setCustomValidity(validationMessage(control)));
      control.addEventListener("input", () => control.setCustomValidity(""));
      control.addEventListener("change", () => control.setCustomValidity(""));
    });
    const params = new URLSearchParams(window.location.search);
    if (params.get("estimator") === "1") {
      form.querySelectorAll("[data-estimator-only]").forEach((element) => {
        element.hidden = false;
      });
      const standardBrief = form.querySelector("[data-standard-brief]");
      if (standardBrief) {
        standardBrief.hidden = true;
        standardBrief.querySelectorAll("input, select, textarea").forEach((control) => {
          control.disabled = true;
        });
      }
      form.querySelector('[name="company"]')?.closest(".field")?.classList.add("estimator-locked-field");
      form.querySelector('[name="service"]')?.closest(".field")?.classList.add("estimator-locked-field");
      form.querySelector('[name="message"]')?.closest(".field")?.classList.add("estimator-locked-field");
      form.querySelector('[name="budget"]')?.closest(".field")?.classList.add("estimator-locked-field");
      form.querySelector('[name="deadline"]')?.closest(".field")?.classList.add("estimator-locked-field");
      form.querySelector('[name="website"]')?.closest(".field")?.classList.add("estimator-locked-field");
      const services = params.get("services") || "";
      const serviceValues = params.get("serviceValues") || "";
      const scope = params.get("scope") || "";
      const complexity = params.get("complexity") || "";
      const timeline = params.get("timeline") || "";
      const estimatedRange = params.get("estimatedRange") || "";
      const extras = params.get("extras") || "";
      const goal = params.get("goal") || "";
      const budget = params.get("budget") || "";
      const recommendations = params.get("recommendations") || "";
      const brief = params.get("brief") || "";
      const message = form.querySelector('[name="message"]');
      const projectScope = form.querySelector('[name="projectScope"]');
      const complexityField = form.querySelector('[name="complexity"]');
      const projectTimeline = form.querySelector('[name="projectTimeline"]');
      const estimatedRangeField = form.querySelector('[name="estimatedRange"]');
      const servicesField = form.querySelector('[name="services"]');
      const goalField = form.querySelector('[name="goal"]');
      const readinessField = form.querySelector('[name="readinessScore"]');
      const leadField = form.querySelector('[name="leadScore"]');
      const confidenceField = form.querySelector('[name="confidence"]');
      const recommendationsField = form.querySelector('[name="recommendations"]');
      const projectBriefField = form.querySelector('[name="projectBrief"]');
      const serviceField = form.querySelector('[name="service"]');
      const budgetField = form.querySelector('[name="budget"]');
      const estimatorBudgetField = form.querySelector("[data-estimator-budget]");
      const isEnglish = form.querySelector('[name="locale"]')?.value === "en";
      const setBriefValue = (selector, value) => {
        const element = form.querySelector(selector);
        if (element) element.textContent = value || "—";
      };
      setBriefValue("[data-brief-goal]", goal);
      setBriefValue("[data-brief-services]", services);
      setBriefValue("[data-brief-scope]", scope);
      setBriefValue("[data-brief-timeline]", timeline);
      setBriefValue("[data-brief-budget]", budget);
      setBriefValue("[data-brief-estimate]", estimatedRange || (isEnglish ? "Individual assessment" : "Индивидуална оценка"));
      if (recommendations) {
        const recommendationRow = form.querySelector("[data-brief-recommendations-row]");
        if (recommendationRow) recommendationRow.hidden = false;
        setBriefValue("[data-brief-recommendations]", recommendations);
      }
      if (message) {
        message.value = brief || (isEnglish
          ? `Project type: ${goal}\n\nSelected services: ${services}\n\nScope: ${scope}\n\nTimeline: ${timeline}\n\nBudget: ${budget}\n\nRecommendations: ${recommendations || "None"}`
          : `Тип проект: ${goal}\n\nИзбрани услуги: ${services}\n\nОбхват: ${scope}\n\nСрок: ${timeline}\n\nБюджет: ${budget}\n\nПрепоръки: ${recommendations || "Няма"}`);
      }
      if (serviceField && serviceValues) serviceField.value = serviceValues.split("|")[0] || "Other";
      if (budgetField && budget) {
        const budgetOption = [...budgetField.options].find((option) => option.textContent?.trim() === budget);
        if (budgetOption) budgetField.value = budgetOption.value;
      }
      if (estimatorBudgetField) {
        const matchedBudget = [...(budgetField?.options || [])].find((option) => option.textContent?.trim() === budget);
        const normalizedBudget =
          matchedBudget?.value ||
          (budget.includes("1,000") && budget.includes("3,000")
            ? "€1,000–€3,000"
            : budget.includes("3,000") && budget.includes("5,000")
              ? "€3,000–€5,000"
              : budget.includes("5,000") && budget.includes("10,000")
                ? "€5,000–€10,000"
                : budget.includes("Под") || budget.includes("Under")
                  ? "Under €1,000"
                  : budget.includes("Над") || budget.includes("Over")
                    ? "Over €10,000"
                    : budget.includes("сигурен") || budget.includes("Sure")
                      ? "Not Sure Yet"
                      : "");
        estimatorBudgetField.value = normalizedBudget;
        estimatorBudgetField.disabled = false;
      }
      if (projectScope) projectScope.value = scope;
      if (complexityField) complexityField.value = complexity;
      if (projectTimeline) projectTimeline.value = timeline;
      if (estimatedRangeField) estimatedRangeField.value = estimatedRange;
      if (servicesField) servicesField.value = serviceValues;
      if (goalField) goalField.value = goal;
      if (readinessField) readinessField.value = params.get("readinessScore") || "";
      if (leadField) leadField.value = params.get("leadScore") || "";
      if (confidenceField) confidenceField.value = params.get("confidence") || "";
      if (recommendationsField) recommendationsField.value = recommendations;
      if (projectBriefField) projectBriefField.value = brief;
      window.requestAnimationFrame(() => {
        document.getElementById("inquiry-form-title")?.scrollIntoView({ behavior: "smooth", block: "start" });
        const firstField = form.querySelector('input[name="name"]');
        window.setTimeout(() => firstField?.focus({ preventScroll: true }), 350);
      });
    }
    if (params.get("sent") === "1") {
      setStatus(form.dataset.successMessage || "", false);
    }
    let formStarted = false;
    form.addEventListener("focusin", () => {
      if (formStarted) return;
      formStarted = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "contact_started", source: params.get("estimator") === "1" ? "estimator" : "contact" });
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.busy === "true") return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      setBusy(true);
      setStatus("");
      const data = new FormData(form);
      if (!data.get("cf-turnstile-response")) {
        setStatus(form.dataset.turnstileError || "", true);
        setBusy(false);
        return;
      }
      try {
        const response = await fetch(form.action, { method: "POST", headers: { Accept: "application/json" }, body: data });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.ok) {
          setStatus(payload?.error || form.dataset.errorMessage || "", true);
          if (window.turnstile?.reset) window.turnstile.reset();
          return;
        }
        form.reset();
        setStatus(form.dataset.successMessage || "", false);
        if (new URLSearchParams(window.location.search).get("estimator") === "1") {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "contact_submitted", source: "estimator" });
        }
        if (window.turnstile?.reset) window.turnstile.reset();
      } catch {
        setStatus(form.dataset.errorMessage || "", true);
        if (window.turnstile?.reset) window.turnstile.reset();
      } finally {
        setBusy(false);
      }
    });
  })();
</script>
