---
interface Props {
  source: string;
}

const { source } = Astro.props;
const lines = source.split("\n");
const isHeading = (line: string) => {
  const trimmed = line.trim();
  return /^\d+\.\s+\S/.test(trimmed);
};
---

<pre class="legal-source">{lines.map((line, index) => (
  <><span class:list={{ "legal-source-heading": isHeading(line) }}>{line}</span>{index < lines.length - 1 ? "\n" : ""}</>
))}</pre>
