---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getOperationalPolicy } from "@/lib/operational-policies";
import { getAbsolutePageUrl } from "@/lib/seo";

interface Props {
  slug: string;
  locale?: Locale;
}

const { slug, locale = "bg" } = Astro.props;
const policy = getOperationalPolicy(slug, locale);

if (!policy) {
  throw new Error(`Unknown operational policy: ${slug}`);
}

const path = `/legal/policies/${policy.slug}`;
const canonical = getAbsolutePageUrl(locale, path);
const isEnglish = locale === "en";
const localeSwitcherItems = [
  { locale: "bg" as const, label: "BG", href: localizeHref("bg", path), isActive: !isEnglish },
  { locale: "en" as const, label: "EN", href: localizeHref("en", path), isActive: isEnglish },
];
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Начало", item: getAbsolutePageUrl(locale, "/") },
    { "@type": "ListItem", position: 2, name: isEnglish ? "Operational policies" : "Оперативни политики", item: getAbsolutePageUrl(locale, "/legal/policies") },
    { "@type": "ListItem", position: 3, name: policy.title, item: canonical },
  ],
};
---

<Layout
  locale={locale}
  title={`${policy.title} | d . media`}
  description={policy.description}
  path={path}
  structuredData={[breadcrumbs]}
  alternateLinks={{
    bg: getAbsolutePageUrl("bg", path),
    en: getAbsolutePageUrl("en", path),
    xDefault: getAbsolutePageUrl("bg", path),
    canonical,
  }}
  localeSwitcherItems={localeSwitcherItems}
>
  <main class="site-shell terms-page" id="top">
    <section class="section-grid">
      <nav class="project-card-footer" aria-label="Навигационна пътека">
        <a class="inline-link" href={localizeHref(locale, "/legal/policies")}>{isEnglish ? "Operational policies" : "Оперативни политики"}</a>
      </nav>

      <div class="section-heading page-intro">
        <p class="eyebrow">{isEnglish ? "Operational policy" : "Оперативна политика"}</p>
        <h1>{policy.title}</h1>
        <p class="page-text"><BrandText text={policy.intro} /></p>
      </div>

      <div class="terms-layout">
        <div class="terms-short">
          {policy.sections.map((section) => (
            <section class="terms-block card terms-short-card">
              <h2>{section.title}</h2>
              {section.paragraphs?.map((paragraph) => (
                <p><BrandText text={paragraph} /></p>
              ))}
              {section.bullets ? (
                <ul class="terms-summary-list">
                  {section.bullets.map((item) => (
                    <li><BrandText text={item} /></li>
                  ))}
                </ul>
              ) : null}
            </section>
          ))}
        </div>
      </div>

      <div class="project-card-footer">
        <a class="inline-link" href={localizeHref(locale, "/legal/policies")}>{isEnglish ? "Back to operational policies" : "Обратно към оперативните политики"}</a>
      </div>
    </section>
  </main>
</Layout>
