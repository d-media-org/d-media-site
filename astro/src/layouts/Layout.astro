---
import PreviewLayout from "@/layouts/PreviewLayout.astro";
import type { Locale } from "@/lib/i18n";
import { localizeHref } from "@/lib/i18n";
import { getUiCopy } from "@/lib/ui-copy";

type Props = {
  locale?: Locale;
  title?: string;
  description?: string;
  path?: string;
  structuredData?: unknown[];
  socialImage?: string;
  openGraphType?: string;
  metaRobots?: string;
  alternateLinks?: {
    bg?: string | null;
    en?: string | null;
    xDefault?: string | null;
    canonical?: string | null;
  };
  localeSwitcherItems?: {
    locale: Locale;
    label: string;
    href: string;
    isActive: boolean;
  }[];
};

const {
  locale = "bg",
  title = "d . media",
  description = "d . media",
  path = "/",
  structuredData = [],
  socialImage,
  openGraphType,
  metaRobots,
  alternateLinks,
  localeSwitcherItems,
} = Astro.props;
const ui = getUiCopy(locale);
---

<PreviewLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  structuredData={structuredData}
  socialImage={socialImage}
  openGraphType={openGraphType}
  metaRobots={metaRobots}
  alternateLinks={alternateLinks}
  localeSwitcherItems={localeSwitcherItems}
>
  <div id="master-content" class="approved-page-content" tabindex="-1">
    <slot />
  </div>

  <div class="consent-banner" role="dialog" aria-live="polite" aria-label={ui.consent.ariaLabel} hidden data-consent-banner>
    <div class="consent-banner-copy">
      <p class="eyebrow">{ui.consent.eyebrow}</p>
      <p>{ui.consent.text}</p>
      <a href={localizeHref(locale, "/privacy")}>{ui.consent.more}</a>
    </div>
    <div class="consent-banner-actions">
      <button type="button" class="button button-secondary" data-consent-choice="rejected">{ui.consent.reject}</button>
      <button type="button" class="button button-primary" data-consent-choice="accepted">{ui.consent.accept}</button>
    </div>
  </div>

  <script is:inline>
    (() => {
      const key = "d-media-consent";
      const version = "2026-06-06";
      const readConsent = () => { try { const value = JSON.parse(localStorage.getItem(key) || "null"); return value?.version === version ? value.choice : null; } catch { return null; } };
      const clean = (value) => typeof value === "string" ? value.slice(0, 120) : typeof value === "number" && Number.isFinite(value) || typeof value === "boolean" ? value : undefined;
      let pageViewSent = false;
      window.dMediaAnalytics = window.dMediaAnalytics || {
        track(name, details = {}) {
          if (readConsent() !== "accepted" || typeof name !== "string") return null;
          const payload = { event: name.replace(/[^a-z0-9_:-]/gi, "_").slice(0, 80), analytics_version: "1", page_path: location.pathname, page_locale: document.documentElement.lang?.startsWith("bg") ? "bg" : "en" };
          Object.entries(details).forEach(([field, value]) => { if (!/^[a-z][a-z0-9_]*$/i.test(field) || ["event", "page_path", "page_locale"].includes(field)) return; const safe = clean(value); if (safe !== undefined) payload[field] = safe; });
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(payload);
          window.dispatchEvent(new CustomEvent("dmedia:analytics", { detail: payload }));
          return payload;
        },
        setConsent(choice) {
          try { localStorage.setItem(key, JSON.stringify({ choice, version })); } catch {}
          if (choice === "accepted") { this.track("consent_granted", { choice }); if (!pageViewSent) { pageViewSent = true; this.track("page_view"); } }
        },
      };
      if (readConsent() === "accepted" && !pageViewSent) { pageViewSent = true; window.dMediaAnalytics.track("page_view"); }
      document.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-ga-event]") : null;
        if (!target || target.closest("[data-consent-banner]")) return;
        const link = target instanceof HTMLAnchorElement ? target : target.querySelector?.("a[href]");
        let linkTarget;
        try { linkTarget = link?.href ? new URL(link.href, location.href).pathname : undefined; } catch {}
        window.dMediaAnalytics.track(target.dataset.gaEvent, { location: target.dataset.gaLocation || "unspecified", link_target: linkTarget });
      }, { capture: true });
    })();
  </script>

  <script is:inline>
    (() => {
      const cta = document.querySelector(".mobile-sticky-cta");
      const form = document.querySelector("#inquiry-form");
      if (!cta || !form || !("IntersectionObserver" in window)) return;
      const observer = new IntersectionObserver(([entry]) => {
        cta.classList.toggle("is-near-form", Boolean(entry?.isIntersecting));
      }, { rootMargin: "120px 0px 0px" });
      observer.observe(form);
    })();
  </script>

  <script is:inline>
    (() => {
      const brand = "d . media";
      const excluded = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "TEXTAREA", "OPTION", "CODE", "PRE", "SVG"]);
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const nodes = [];
      while (walker.nextNode()) {
        const node = walker.currentNode;
        const parent = node.parentElement;
        if (!parent || excluded.has(parent.tagName) || parent.closest(".brand-name, script, style, noscript, textarea, option, code, pre, svg") || !node.nodeValue?.includes(brand)) continue;
        nodes.push(node);
      }
      nodes.forEach((node) => {
        const parts = node.nodeValue.split(brand);
        const fragment = document.createDocumentFragment();
        parts.forEach((part, index) => {
          if (part) fragment.append(document.createTextNode(part));
          if (index < parts.length - 1) {
            const span = document.createElement("span");
            span.className = "brand-name";
            span.textContent = brand;
            fragment.append(span);
          }
        });
        node.replaceWith(fragment);
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const banner = document.querySelector("[data-consent-banner]");
      if (!banner) return;
      const key = "d-media-consent";
      const version = "2026-06-06";
      const readConsent = () => {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          return parsed?.version === version ? parsed.choice : null;
        } catch { return null; }
      };
      const hide = () => {
        banner.hidden = true;
        banner.setAttribute("aria-hidden", "true");
      };
      if (!["accepted", "rejected"].includes(readConsent())) {
        banner.hidden = false;
        banner.setAttribute("aria-hidden", "false");
      }
      banner.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-consent-choice]") : null;
        if (!(button instanceof HTMLElement)) return;
        try { localStorage.setItem(key, JSON.stringify({ choice: button.dataset.consentChoice || "rejected", version })); } catch {}
        window.dMediaAnalytics?.setConsent(button.dataset.consentChoice || "rejected");
        hide();
      });
    })();
  </script>

  <script is:inline define:vars={{ closeLabel: ui.closePreview }}>
    (() => {
      let overlay = null;
      let lastTrigger = null;
      const close = () => {
        overlay?.remove();
        overlay = null;
        document.documentElement.classList.remove("is-gallery-open");
        lastTrigger?.focus?.();
      };
      const open = (src, alt, trigger) => {
        close();
        lastTrigger = trigger;
        const normalizedSrc = String(src || "").toLowerCase();
        const normalizedAlt = String(alt || "").toLowerCase();
        const isDmediaBrandAsset =
          normalizedSrc.includes("d-media") ||
          normalizedSrc.includes("/project-web/d-media/") ||
          normalizedSrc.includes("/assets/brand/") ||
          normalizedSrc.includes("/optimized-assets/brand/") ||
          normalizedAlt.includes("d . media") ||
          normalizedAlt.includes("d.media");
        overlay = document.createElement("div");
        overlay.className = isDmediaBrandAsset ? "gallery-lightbox gallery-lightbox-brand-contrast" : "gallery-lightbox";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", alt);
        const panel = document.createElement("div");
        panel.className = "gallery-lightbox-panel";
        const topbar = document.createElement("div");
        topbar.className = "gallery-lightbox-topbar";
        const closeButton = document.createElement("button");
        closeButton.type = "button";
        closeButton.className = "gallery-lightbox-close";
        closeButton.setAttribute("aria-label", closeLabel);
        closeButton.textContent = "×";
        const frame = document.createElement("div");
        frame.className = "gallery-lightbox-frame";
        const imageWrap = document.createElement("div");
        imageWrap.className = "gallery-lightbox-image";
        const image = document.createElement("img");
        image.alt = alt;
        image.loading = "eager";
        image.decoding = "async";
        image.draggable = false;
        image.src = src;
        imageWrap.append(image);
        frame.append(imageWrap);
        topbar.append(closeButton);
        panel.append(topbar, frame);
        overlay.append(panel);
        overlay.addEventListener("click", (event) => { if (event.target === overlay) close(); });
        closeButton.addEventListener("click", close);
        document.body.append(overlay);
        document.documentElement.classList.add("is-gallery-open");
        closeButton.focus();
      };
      document.addEventListener("click", (event) => {
        const trigger = event.target instanceof Element ? event.target.closest("[data-gallery-trigger]") : null;
        if (!(trigger instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        open(trigger.getAttribute("href"), trigger.dataset.galleryAlt || "", trigger);
      });
      addEventListener("keydown", (event) => { if (event.key === "Escape" && overlay) close(); });
    })();
  </script>
</PreviewLayout>
