---
import "../styles/production-baseline.css";
import "../styles/project-portfolio.css";

import BrandAsset from "@/components/BrandAsset.astro";
import { getAbsolutePageUrl, getOrganizationSchema, getWebPageSchema, getWebsiteSchema } from "@/lib/seo";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getLocaleSwitcherItems, getUiCopy } from "@/lib/ui-copy";
import { contactEmail, getSiteContent } from "@/lib/site-content";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  structuredData?: unknown[];
  socialImage?: string;
  openGraphType?: string;
  metaRobots?: string;
  alternateLinks?: {
    bg?: string | null;
    en?: string | null;
    xDefault?: string | null;
    canonical?: string | null;
  };
  localeSwitcherItems?: {
    locale: Locale;
    label: string;
    href: string;
    isActive: boolean;
  }[];
  preview?: boolean;
};

const {
  locale,
  title,
  description,
  path = "/",
  structuredData = [],
  socialImage = "https://www.d-media.org/social-preview-dmedia-v5.png",
  openGraphType = "website",
  metaRobots,
  alternateLinks,
  localeSwitcherItems,
  preview = false,
} = Astro.props;
const content = getSiteContent(locale);
const encodedContactEmailHref = `mailto:${contactEmail.replace("@", "%40")}`;
const encodedContactEmailLabel = contactEmail.replace("@", "&#64;");
const ui = getUiCopy(locale);
const isBg = locale === "bg";
const prefix = isBg ? "" : "/en";
const route = (path: string) => `${prefix}${path === "/" ? "/" : `${path}/`}`;
const canonicalHref = alternateLinks?.canonical ?? getAbsolutePageUrl(locale, path);
const alternateBgHref = alternateLinks?.bg === null ? null : (alternateLinks?.bg ?? getAbsolutePageUrl("bg", path));
const alternateEnHref = alternateLinks?.en === null ? null : (alternateLinks?.en ?? getAbsolutePageUrl("en", path));
const alternateXDefaultHref = alternateLinks?.xDefault === null ? null : (alternateLinks?.xDefault ?? getAbsolutePageUrl("bg", path));
const schemas = [
  getOrganizationSchema(locale),
  getWebsiteSchema(locale),
  getWebPageSchema({ locale, path, title, description }),
  ...structuredData,
];
const normalizedPath = localizeHref(locale, path);
const normalizeRoute = (value: string) => value === "/" ? value : value.replace(/\/+$/, "");
const isActive = (href: string) => {
  const current = normalizeRoute(normalizedPath);
  const target = normalizeRoute(href);
  return target === (isBg ? "/" : "/en") ? current === target : current === target || current.startsWith(`${target}/`);
};
const resolvedLocaleSwitcherItems = localeSwitcherItems ?? getLocaleSwitcherItems(locale, path);
const serviceById = new Map(content.coreServices.map((service) => [service.id, service]));
const serviceGroups = [
  {
    title: isBg ? "Идентичност и дизайн" : "Identity and design",
    services: ["brand-identity", "graphic-design"],
  },
  {
    title: isBg ? "Съдържание и комуникация" : "Content and communication",
    services: ["content", "social-media-management", "advertising"],
  },
  {
    title: isBg ? "Уеб и видимост" : "Web and visibility",
    services: ["web-design-development", "technical-seo", "geo", "performance-optimization", "technical-support"],
  },
].map((group) => ({
  ...group,
  services: group.services.map((id) => serviceById.get(id)).filter(Boolean),
}));

const primaryNav = content.mainNavigation
  .filter((item) => item.href !== "/services")
  .map((item) => ({ label: item.label, href: route(item.href) }));
const homeNavItem = primaryNav.find((item) => item.href === route("/"));
const remainingPrimaryNav = primaryNav.filter((item) => item.href !== route("/"));
const footerServices = [
  { label: isBg ? "бранд и дизайн" : "brand and design", href: route("/services/brand-identity") },
  { label: isBg ? "съдържание" : "content", href: route("/services/content-creation") },
  { label: isBg ? "уеб платформи" : "web platforms", href: route("/services/web-design-development") },
  { label: isBg ? "SEO, GEO и видимост" : "SEO, GEO and visibility", href: route("/services/technical-seo") },
];
const footerProjects = [
  { label: isBg ? "всички проекти" : "all projects", href: route("/projects") },
  { label: "case studies", href: route("/case-studies") },
];
const footerInformation = [
  { label: isBg ? "начални рамки" : "starting ranges", href: route("/pricing") },
  { label: isBg ? "за бранда" : "about d . media", href: route("/about") },
  { label: isBg ? "контакти" : "contacts", href: route("/contact") },
];
const footerLegal = [
  { label: isBg ? "условия" : "terms", href: route("/terms") },
  { label: isBg ? "оперативни политики" : "operational policies", href: route("/legal/policies") },
  { label: isBg ? "поверителност" : "privacy", href: route("/privacy") },
  { label: isBg ? "история на сайта" : "site history", href: route("/site-history") },
];
const socialIconPaths: Record<string, string> = {
  Instagram: "M16.98 3H7.02A4.02 4.02 0 0 0 3 7.02v9.96A4.02 4.02 0 0 0 7.02 21h9.96A4.02 4.02 0 0 0 21 16.98V7.02A4.02 4.02 0 0 0 16.98 3Zm1.47 13.98a1.47 1.47 0 0 1-1.47 1.47H7.02a1.47 1.47 0 0 1-1.47-1.47V7.02a1.47 1.47 0 0 1 1.47-1.47h9.96a1.47 1.47 0 0 1 1.47 1.47v9.96ZM12 7.06A4.94 4.94 0 1 0 16.94 12 4.95 4.95 0 0 0 12 7.06Zm0 7.33A2.39 2.39 0 1 1 14.39 12 2.39 2.39 0 0 1 12 14.39Zm5.05-7.74a1.15 1.15 0 1 1-1.15-1.15 1.15 1.15 0 0 1 1.15 1.15Z",
  Behance: "M9.35 11.4A2.73 2.73 0 0 0 10.88 8.8C10.88 6.2 8.96 5 6.48 5H2v14h4.79c2.62 0 4.86-1.26 4.86-4.03a3.52 3.52 0 0 0-2.3-3.57ZM4.64 7.22h1.73c.66 0 1.68.12 1.68 1.39 0 1.2-.8 1.43-1.57 1.43H4.64V7.22Zm1.89 9.56H4.64v-4.43h1.96c.98 0 2.34.28 2.34 2.18 0 1.58-1 2.25-2.07 2.25Zm9.86-8.35c-3.38 0-5.39 2.52-5.39 5.42 0 3.18 1.88 5.42 5.31 5.42 2.21 0 3.9-1 4.66-3.23h-2.43a2.24 2.24 0 0 1-2.14 1.1c-1.5 0-2.56-.9-2.62-2.68H21c.22-3.45-1.7-6.03-4.61-6.03Zm-2.55 4.07a2.44 2.44 0 0 1 2.42-2.14 2.14 2.14 0 0 1 2.15 2.14h-4.57ZM13 6.4h6V5h-6v1.4Z",
  LinkedIn: "M19.8 3.6H4.2C3.54 3.6 3 4.14 3 4.8V19.2C3 19.86 3.54 20.4 4.2 20.4H19.8C20.46 20.4 21 19.86 21 19.2V4.8C21 4.14 20.46 3.6 19.8 3.6ZM8.1 18H5.7V10.2H8.1V18ZM6.9 9.12C6.12 9.12 5.49 8.48 5.49 7.71C5.49 6.93 6.12 6.3 6.9 6.3C7.68 6.3 8.31 6.93 8.31 7.71C8.31 8.48 7.68 9.12 6.9 9.12ZM18.3 18H15.9V14.13C15.9 13.21 15.88 12.03 14.61 12.03C13.31 12.03 13.11 13.04 13.11 14.06V18H10.71V10.2H13.02V11.27H13.05C13.37 10.66 14.16 10.01 15.33 10.01C17.76 10.01 18.3 11.61 18.3 13.69V18Z",
  TikTok: "M14.7 3c.24 2.02 1.42 3.95 3.37 5.08a6.35 6.35 0 0 0 2.33.79v2.74a9.03 9.03 0 0 1-3.07-.58v5.05c0 3.55-2.88 6.42-6.43 6.42S4.48 19.63 4.48 16.08 7.36 9.66 10.9 9.66c.3 0 .6.02.89.07v2.84a3.66 3.66 0 0 0-.89-.12 3.63 3.63 0 1 0 3.63 3.63V3h2.17Z",
  YouTube: "M20.2 8.3C20 7.5 19.4 6.9 18.6 6.7C17.2 6.3 12 6.3 12 6.3S6.8 6.3 5.4 6.7C4.6 6.9 4 7.5 3.8 8.3C3.4 9.7 3.4 12.5 3.4 12.5s0 2.8.4 4.2c.2.8.8 1.4 1.6 1.6 1.4.4 6.6.4 6.6.4s5.2 0 6.6-.4c.8-.2 1.4-.8 1.6-1.6.4-1.4.4-4.2.4-4.2s0-2.8-.4-4.2ZM10.4 15.2V9.8l4.6 2.7-4.6 2.7Z",
};
---

<!doctype html>
<html lang={locale} data-theme="light" data-theme-mode="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : (metaRobots ? <meta name="robots" content={metaRobots} /> : null)}
    {!preview ? <link rel="canonical" href={canonicalHref} /> : null}
    {!preview && alternateBgHref ? <link rel="alternate" hreflang="bg" href={alternateBgHref} /> : null}
    {!preview && alternateEnHref ? <link rel="alternate" hreflang="en" href={alternateEnHref} /> : null}
    {!preview && alternateXDefaultHref ? <link rel="alternate" hreflang="x-default" href={alternateXDefaultHref} /> : null}
    <link rel="icon" type="image/png" sizes="32x32" href="/dmedia-favicon-v6-32.png" />
    <link rel="preload" href="/fonts/panton-subset/Panton-Light.latin-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/panton-subset/Panton-Regular.latin-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/panton-subset/Panton-SemiBold.latin-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/panton-subset/Panton-Bold.latin-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/panton-subset/Panton-Black.latin-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    {!preview ? (
      <>
        <meta property="og:type" content={openGraphType} />
        <meta property="og:site_name" content="d . media" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalHref} />
        <meta property="og:image" content={socialImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
      </>
    ) : null}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("mp-js");
        const stored = (() => {
          try { return localStorage.getItem("d-media-theme-mode") || "auto"; } catch { return "auto"; }
        })();
        const mode = ["auto", "light", "dark"].includes(stored) ? stored : "auto";
        root.dataset.themeMode = mode;
        root.dataset.theme = mode === "auto"
          ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : mode;
      })();
    </script>
  </head>
  <body>
    <a class="mp-skip-link" href="#master-content">{isBg ? "Към съдържанието" : "Skip to content"}</a>
    <header class="mp-header" data-master-header>
      <div class="mp-header-inner">
        <a class="mp-logo" href={route("/")} aria-label={isBg ? "Начало" : "Home"} aria-current={isActive(route("/")) ? "page" : undefined}>
          <BrandAsset class="mp-brand-outline" lightSrc="/preview-assets/d-media-logotype-stroke-ui.png" alt="d . media" width={512} height={134} fetchPriority="high" />
        </a>

        <nav class="mp-desktop-nav" aria-label={isBg ? "Основна навигация" : "Main navigation"}>
          <div class="mp-nav-group">
            {homeNavItem ? <a class="mp-nav-link" href={homeNavItem.href} aria-current={isActive(homeNavItem.href) ? "page" : undefined}><span class="mp-nav-label">{homeNavItem.label}</span></a> : null}
            <div class="mp-services-nav" data-desktop-services-wrap>
              <button class="mp-nav-link mp-services-trigger" type="button" aria-expanded="false" aria-controls="mp-services-panel" aria-current={isActive(route("/services")) ? "page" : undefined} data-desktop-services-trigger>
                <span class="mp-nav-label">{isBg ? "Услуги" : "Services"}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
              </button>
              <div class="mp-services-panel" id="mp-services-panel" data-desktop-services-panel hidden>
                <div class="mp-services-panel-inner">
                  {serviceGroups.map((group) => (
                    <section>
                      <h2>{group.title}</h2>
                      <ul>
                        {group.services.map((service) => service && (
                          <li><a href={route(service.detailHref)}>{service.title}</a></li>
                        ))}
                      </ul>
                    </section>
                  ))}
                  <a class="mp-services-all" href={route("/services")}>
                    {isBg ? "всички услуги" : "all services"}
                    <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4" /></svg>
                  </a>
                </div>
              </div>
            </div>
            {remainingPrimaryNav.map((item) => <a class:list={["mp-nav-link", { "mp-nav-pricing": item.href === route("/pricing") }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}><span class="mp-nav-label">{item.label}</span></a>)}
          </div>
        </nav>

        <div class="mp-header-tools">
          <div class="mp-language" aria-label={isBg ? "Избор на език" : "Language switcher"}>
            {(preview ? [
              { locale: "bg" as const, label: "BG", href: "/preview/", isActive: isBg },
              { locale: "en" as const, label: "EN", href: "/en/preview/", isActive: !isBg },
            ] : resolvedLocaleSwitcherItems).map((item) => (
              <a href={item.href} lang={item.locale} hreflang={item.locale} aria-current={item.isActive ? "page" : undefined}>{item.label}</a>
            ))}
          </div>
          <div class="mp-theme-control" role="group" aria-label={isBg ? "Цветова схема" : "Color theme"}>
            <button type="button" data-mp-theme="auto" aria-label={isBg ? "Автоматична тема" : "Automatic theme"}>A</button>
            <button type="button" data-mp-theme="light" aria-label={isBg ? "Светла тема" : "Light theme"}>
              <svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="2.7" /><path d="M9 1.8v2M9 14.2v2M1.8 9h2M14.2 9h2M3.9 3.9l1.4 1.4M12.7 12.7l1.4 1.4M3.9 14.1l1.4-1.4M12.7 5.3l1.4-1.4" /></svg>
            </button>
            <button type="button" data-mp-theme="dark" aria-label={isBg ? "Тъмна тема" : "Dark theme"}>
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M12.8 11.9A5.8 5.8 0 0 1 6.1 5.2a5.9 5.9 0 1 0 6.7 6.7Z" /></svg>
            </button>
          </div>
        </div>

        <button class="mp-menu-button" type="button" aria-expanded="false" aria-controls="mp-mobile-menu" aria-label={isBg ? "Отвори менюто" : "Open menu"} data-mobile-menu-trigger>
          <span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mp-mobile-menu" id="mp-mobile-menu" data-mobile-menu hidden>
      <div class="mp-mobile-menu-inner">
        <nav aria-label={isBg ? "Мобилна навигация" : "Mobile navigation"}>
          <div class="mp-mobile-nav-group">
            {homeNavItem ? <a href={homeNavItem.href} aria-current={isActive(homeNavItem.href) ? "page" : undefined}>{homeNavItem.label}</a> : null}
            <button type="button" class="mp-mobile-services-trigger" aria-expanded="false" aria-controls="mp-mobile-services" aria-current={isActive(route("/services")) ? "page" : undefined} data-mobile-services-trigger>
              <span>{isBg ? "Услуги" : "Services"}</span>
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3v12M3 9h12" /></svg>
            </button>
            <div class="mp-mobile-services" id="mp-mobile-services" data-mobile-services hidden>
              {serviceGroups.map((group) => (
                <section>
                  <h2>{group.title}</h2>
                  {group.services.map((service) => service && <a href={route(service.detailHref)}>{service.title}</a>)}
                </section>
              ))}
              <a href={route("/services")}>{isBg ? "всички услуги" : "all services"}</a>
            </div>
            {remainingPrimaryNav.filter((item) => item.href === route("/projects")).map((item) => <a class:list={{ "mp-nav-pricing": item.href === route("/pricing") }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
          </div>
          <div class="mp-mobile-nav-group mp-mobile-nav-secondary">
            {remainingPrimaryNav.filter((item) => item.href !== route("/projects")).map((item) => <a class:list={{ "mp-nav-pricing": item.href === route("/pricing") }} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
          </div>
          <a class="mp-mobile-menu-cta" href={route("/contact")}>{isBg ? "изпрати проектен контекст" : "send project context"}</a>
        </nav>
        <div class="mp-mobile-meta">
          <a href={encodedContactEmailHref}><span set:html={encodedContactEmailLabel} /></a>
          <a class="mp-mobile-cta" href={route("/contact")}>{isBg ? "изпрати проектен контекст" : "send project context"}</a>
          <div class="mp-mobile-socials" aria-label={isBg ? "Социални профили" : "Social profiles"}>
            {content.socials.map((social) => (
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={socialIconPaths[social.label]} fill="currentColor" /></svg>
              </a>
            ))}
          </div>
          <div class="mp-mobile-controls">
            <div class="mp-language" aria-label={isBg ? "Избор на език" : "Language switcher"}>
              {(preview ? [
                { locale: "bg" as const, label: "BG", href: "/preview/", isActive: isBg },
                { locale: "en" as const, label: "EN", href: "/en/preview/", isActive: !isBg },
              ] : resolvedLocaleSwitcherItems).map((item) => (
                <a href={item.href} lang={item.locale} hreflang={item.locale} aria-current={item.isActive ? "page" : undefined}>{item.label}</a>
              ))}
            </div>
            <div class="mp-theme-control" role="group" aria-label={isBg ? "Цветова схема" : "Color theme"}>
              <button type="button" data-mp-theme="auto" aria-label={isBg ? "Автоматична тема" : "Automatic theme"}>A</button>
              <button type="button" data-mp-theme="light" aria-label={isBg ? "Светла тема" : "Light theme"}>
                <svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="2.7" /><path d="M9 1.8v2M9 14.2v2M1.8 9h2M14.2 9h2" /></svg>
              </button>
              <button type="button" data-mp-theme="dark" aria-label={isBg ? "Тъмна тема" : "Dark theme"}>
                <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M12.8 11.9A5.8 5.8 0 0 1 6.1 5.2a5.9 5.9 0 1 0 6.7 6.7Z" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <slot />

    <footer class="mp-footer" data-header-tone="dark">
      <div class="mp-footer-shell">
        <div class="mp-footer-nav-grid">
          <nav class="mp-footer-links" aria-label={isBg ? "Услуги" : "Services"}>
            <span>{isBg ? "услуги" : "services"}</span>
            {footerServices.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <nav class="mp-footer-links" aria-label={isBg ? "Проекти" : "Projects"}>
            <span>{isBg ? "проекти" : "projects"}</span>
            {footerProjects.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <nav class="mp-footer-links" aria-label={isBg ? "Информация" : "Information"}>
            <span>{isBg ? "информация" : "information"}</span>
            {footerInformation.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <div class="mp-footer-socials">
            <span>{isBg ? "социални" : "social"}</span>
            {content.socials.map((social) => (
              <a href={social.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={socialIconPaths[social.label]} fill="currentColor" /></svg>
                <span>{social.label}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="mp-footer-bottom">
          <a class="mp-footer-logo" href={route("/")} aria-label={isBg ? "Начало" : "Home"}>
          <BrandAsset class="mp-brand-outline" lightSrc="/preview-assets/d-media-logo-stroke-ui.png" alt="d . media" width={472} height={512} loading="lazy" />
          </a>
          <nav class="mp-footer-legal" aria-label={isBg ? "Правна информация" : "Legal information"}>
            {footerLegal.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <p>© 2026 <strong>d . media</strong>. {isBg ? "Всички права запазени." : "All rights reserved."}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const themeButtons = [...document.querySelectorAll("[data-mp-theme]")];
        const readMode = () => {
          try {
            const value = localStorage.getItem("d-media-theme-mode");
            return ["auto", "light", "dark"].includes(value) ? value : "auto";
          } catch { return "auto"; }
        };
        const applyTheme = (mode) => {
          const theme = mode === "auto" ? (media.matches ? "dark" : "light") : mode;
          root.dataset.themeMode = mode;
          root.dataset.theme = theme;
          themeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.mpTheme === mode)));
          try { localStorage.setItem("d-media-theme-mode", mode); } catch {}
        };
        themeButtons.forEach((button) => button.addEventListener("click", () => applyTheme(button.dataset.mpTheme || "auto")));
        media.addEventListener?.("change", () => { if (readMode() === "auto") applyTheme("auto"); });
        applyTheme(readMode());

        const header = document.querySelector("[data-master-header]");
        const desktopTrigger = document.querySelector("[data-desktop-services-trigger]");
        const desktopPanel = document.querySelector("[data-desktop-services-panel]");
        const closeDesktopServices = (restore = false) => {
          if (!desktopTrigger || !desktopPanel) return;
          desktopTrigger.setAttribute("aria-expanded", "false");
          desktopPanel.hidden = true;
          if (restore) desktopTrigger.focus();
        };
        desktopTrigger?.addEventListener("click", () => {
          const open = desktopTrigger.getAttribute("aria-expanded") === "true";
          desktopTrigger.setAttribute("aria-expanded", String(!open));
          if (desktopPanel) desktopPanel.hidden = open;
        });
        document.addEventListener("click", (event) => {
          const wrap = document.querySelector("[data-desktop-services-wrap]");
          if (wrap && event.target instanceof Node && !wrap.contains(event.target)) closeDesktopServices();
        });

        const menu = document.querySelector("[data-mobile-menu]");
        const menuTrigger = document.querySelector("[data-mobile-menu-trigger]");
        const mobileServicesTrigger = document.querySelector("[data-mobile-services-trigger]");
        const mobileServices = document.querySelector("[data-mobile-services]");
        let previousFocus = null;
        const focusable = () => menu ? [...menu.querySelectorAll("a[href], button:not([disabled])")].filter((item) => !item.closest("[hidden]")) : [];
        const closeMenu = (restore = true) => {
          if (!menu || !menuTrigger) return;
          menu.hidden = true;
          menuTrigger.setAttribute("aria-expanded", "false");
          menuTrigger.setAttribute("aria-label", menuTrigger.dataset.openLabel || (document.documentElement.lang === "bg" ? "Отвори менюто" : "Open menu"));
          document.body.classList.remove("mp-menu-open");
          if (restore && previousFocus instanceof HTMLElement) previousFocus.focus();
        };
        const openMenu = () => {
          if (!menu || !menuTrigger) return;
          previousFocus = document.activeElement;
          menu.hidden = false;
          menuTrigger.setAttribute("aria-expanded", "true");
          menuTrigger.setAttribute("aria-label", document.documentElement.lang === "bg" ? "Затвори менюто" : "Close menu");
          document.body.classList.add("mp-menu-open");
          requestAnimationFrame(() => focusable()[0]?.focus());
        };
        menuTrigger?.setAttribute("data-open-label", menuTrigger.getAttribute("aria-label") || "");
        menuTrigger?.addEventListener("click", () => menuTrigger.getAttribute("aria-expanded") === "true" ? closeMenu() : openMenu());
        mobileServicesTrigger?.addEventListener("click", () => {
          const open = mobileServicesTrigger.getAttribute("aria-expanded") === "true";
          mobileServicesTrigger.setAttribute("aria-expanded", String(!open));
          if (mobileServices) mobileServices.hidden = open;
        });
        menu?.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) closeMenu(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            if (menu && !menu.hidden) closeMenu();
            else closeDesktopServices(true);
          }
          if (event.key !== "Tab" || !menu || menu.hidden) return;
          const items = focusable();
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        });
        matchMedia("(min-width: 1120px)").addEventListener?.("change", (event) => { if (event.matches) closeMenu(false); });

        if ("scrollRestoration" in history) history.scrollRestoration = "auto";
        document.addEventListener("click", (event) => {
          const link = event.target instanceof Element ? event.target.closest("[data-history-back]") : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          const referrer = document.referrer ? new URL(document.referrer) : null;
          if (history.length <= 1 || referrer?.origin !== location.origin) return;
          event.preventDefault();
          history.back();
        });

        const updateHeader = () => {
          if (!header) return;
          header.toggleAttribute("data-scrolled", scrollY > 18);
          const point = document.elementFromPoint(innerWidth / 2, Math.min(header.getBoundingClientRect().bottom + 2, innerHeight - 1));
          header.dataset.tone = point?.closest("[data-header-tone]")?.getAttribute("data-header-tone") || "surface";
        };
        addEventListener("scroll", updateHeader, { passive: true });
        addEventListener("resize", updateHeader);
        updateHeader();

        const reveals = [...document.querySelectorAll("[data-reveal]")];
        if (reduced || !("IntersectionObserver" in window)) reveals.forEach((item) => item.classList.add("is-visible"));
        else {
          const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }), { rootMargin: "0px 0px -8%", threshold: 0.12 });
          reveals.forEach((item) => observer.observe(item));
        }
      })();
    </script>

  </body>
</html>
