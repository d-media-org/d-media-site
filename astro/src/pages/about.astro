---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema } from "@/lib/seo";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "bg";
const copy = getPageCopy(locale).about;
const siteContent = getSiteContent(locale);
const brandbookWebHref =
  locale === "en" ? "/brandbook_web_exact_en/index.html" : "/brandbook_web_exact/index.html";
const brandbookOpenLabel = locale === "en" ? "Open brand book" : "Отвори брандбук";
const logoPackDownloadLabel =
  locale === "en" ? "Download brand logo and logotype" : "Свали лого и логотип на марката";
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/about" structuredData={[getBreadcrumbSchema({ locale, path: "/about", title: copy.metaTitle })]}>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1><span class="brand-name">d . media</span></h1>
        <p class="page-text">{copy.text}</p>
      </div>
      <div class="split-content page-grid stacked-cards">
        <div class="card about-copy content-card-wide">
          {siteContent.aboutNotes.map((item) => (
            <p>
              <BrandText text={item} />
            </p>
          ))}
        </div>
        <div class="card about-copy content-card-wide">
          <p>
            <BrandText text="Работим от София с организации и екипи, които имат нужда от ясна система за бранда и присъствието си. Възможен е самостоятелен обхват или цялостна работа между идентичност, съдържание, дизайн, уеб и видимост." />
          </p>
        </div>
        <div class="card package-card content-card-wide brandbook-card">
          <h2>{copy.brandbookTitle}</h2>
          <p>{copy.brandbookText}</p>
          <div class="hero-actions brandbook-actions">
            <a href={brandbookWebHref} target="_blank" rel="noreferrer" class="button button-secondary desktop-only">
              {brandbookOpenLabel}
            </a>
            <a href="/downloads/d-media-logo-pack.zip" class="button button-secondary" download>
              {logoPackDownloadLabel}
            </a>
          </div>
        </div>
        <div class="card about-copy content-card-wide">
          <h2>Как работим</h2>
          <p>Започваме от контекста и обхвата, развиваме решението в реална среда, проверяваме го и предаваме договорените материали. Подходът следва задачата, наличната основа и начина, по който резултатът ще се използва.</p>
          <div class="blog-related-list">
            <a class="inline-link" href="/our-process/">Процес</a>
            <a class="inline-link" href="/methodology/">Методология</a>
            <a class="inline-link" href="/technologies/">Технологии</a>
            <a class="inline-link" href="/performance/">Стандарт за скорост</a>
            <a class="inline-link" href="/faq/">Често задавани въпроси</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
