---
import Layout from "@/layouts/Layout.astro";
import {
  getBlogCategories,
  getBlogCategoryLabel,
  getBlogPageCopy,
  getPublishedBlogPosts,
} from "@/lib/blog";
import { type Locale } from "@/lib/i18n";
import { localizeHref } from "@/lib/i18n";
import { getBreadcrumbSchema } from "@/lib/seo";

const locale: Locale = "bg";
const copy = getBlogPageCopy(locale);
const posts = getPublishedBlogPosts(locale);
const categories = getBlogCategories(locale);
---

<Layout
  locale={locale}
  title={`${copy.metaTitle} | d . media`}
  description={copy.metaDescription}
  path="/blog"
  openGraphType="website"
  structuredData={[getBreadcrumbSchema({ locale, path: "/blog", title: copy.metaTitle })]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <p class="eyebrow">blog</p>
        <h1>{copy.title}</h1>
        <p class="page-text">{copy.intro}</p>
      </div>

      <nav class="blog-filters" aria-label={copy.filtersLabel} data-blog-filters>
        <a class="button button-secondary is-active" href="/blog/" data-blog-filter="all">{copy.allLabel}</a>
        {categories.map((category) => (
          <a class="button button-secondary" href={`/blog/?category=${category.key}`} data-blog-filter={category.key}>{category.label}</a>
        ))}
      </nav>

      <p class="page-text">Търсиш систематизирани технически материали? <a class="inline-link" href="/knowledge-base/">Разгледай База знания</a>.</p>

      <div class="project-grid" data-blog-grid>
        {posts.map((post) => (
          <article class={`card service-category-card${post.featured ? " is-featured" : ""}`} data-blog-card data-category={post.category}>
            <div class="blog-meta-row">
              <p class="project-meta">{getBlogCategoryLabel(locale, post.category)}</p>
            </div>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            <div class="project-card-footer">
              <a class="inline-link" href={localizeHref(locale, `/blog/${post.slug}`)}>{copy.articleCta}</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const cards = [...document.querySelectorAll("[data-blog-card]")];
      const filters = [...document.querySelectorAll("[data-blog-filter]")];
      const applyFilter = (category) => {
        cards.forEach((card) => { card.hidden = category !== "all" && card.dataset.category !== category; });
        filters.forEach((filter) => filter.classList.toggle("is-active", filter.dataset.blogFilter === category));
      };
      const category = new URLSearchParams(location.search).get("category") || "all";
      applyFilter(filters.some((filter) => filter.dataset.blogFilter === category) ? category : "all");
      filters.forEach((filter) => filter.addEventListener("click", (event) => {
        event.preventDefault();
        const next = filter.dataset.blogFilter || "all";
        history.replaceState(null, "", next === "all" ? "/blog/" : `/blog/?category=${next}`);
        applyFilter(next);
      }));
    })();
  </script>
</Layout>
