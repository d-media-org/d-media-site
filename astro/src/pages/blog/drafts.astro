---
import Layout from "@/layouts/Layout.astro";
import {
  formatBlogDate,
  getBlogCategoryLabel,
  getBlogPageCopy,
  getDraftBlogPosts,
} from "@/lib/blog";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getUiCopy } from "@/lib/ui-copy";

const locale: Locale = "bg";
const copy = getBlogPageCopy(locale);
const isDev = import.meta.env.DEV;
const ui = getUiCopy(locale);
const localeSwitcherItems = [
  {
    locale: "bg" as const,
    label: ui.localeLabel,
    href: localizeHref("bg", "/blog/drafts"),
    isActive: true,
  },
  {
    locale: "en" as const,
    label: "EN",
    href: "/en/blog",
    isActive: false,
  },
];

if (!isDev) {
  Astro.response.status = 404;
}

const drafts = isDev ? getDraftBlogPosts(locale) : [];
---

<Layout
  locale={locale}
  title={`Draft статии | d . media`}
  description="Локален development preview на непубликувани статии и казуси в d . media, използван само за проверка преди публично включване."
  path="/blog/drafts"
  openGraphType="website"
  metaRobots="noindex, nofollow, noarchive"
  localeSwitcherItems={localeSwitcherItems}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <p class="eyebrow">draft preview</p>
        <h1>Draft статии</h1>
        <p class="page-text">
          {isDev
            ? "Локален preview на непубликуваните статии и казуси. Този route е само за development и не влиза в sitemap."
            : "Тази страница не е публична."}
        </p>
      </div>

      {isDev ? (
        <div class="project-grid">
          {drafts.map((post) => (
            <article class="card service-category-card">
              <div class="blog-meta-row">
                <p class="project-meta">{getBlogCategoryLabel(locale, post.category)}</p>
                <p class="project-meta">
                  <time datetime={post.datePublished}>{formatBlogDate(locale, post.datePublished)}</time> · {post.readingTime} {copy.readTimeLabel}
                </p>
              </div>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
              <p class="project-meta">slug: {post.slug}</p>
              <div class="project-card-footer">
                <a class="inline-link" href={`/blog/drafts/${post.slug}`}>Прочети казуса</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <article class="card services-cta-card">
          <div class="services-cta-copy">
            <h2>404</h2>
            <p class="page-text">Draft preview е достъпен само локално в development режим.</p>
          </div>
        </article>
      )}
    </section>
  </main>
</Layout>
