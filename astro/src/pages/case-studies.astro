---
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getResolvedAllProjectsArchive } from "@/lib/asset-url";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getBreadcrumbSchema } from "@/lib/seo";

const locale: Locale = "bg";
const caseStudies = getResolvedAllProjectsArchive(locale).filter((project) => "isCaseStudy" in project && project.isCaseStudy);
---

<Layout
  locale={locale}
  title="Казуси | d . media"
  description="Задълбочени истории за избрани проекти от секцията „Работа“ на d . media."
  path="/case-studies"
  structuredData={[getBreadcrumbSchema({ locale, path: "/case-studies", title: "Казуси" })]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>Казуси</h1>
        <p class="page-text">
          Задълбочени истории за избрани проекти от секцията „Работа“.
        </p>
        <a class="inline-link" href={localizeHref(locale, "/projects")}>Към цялата работа</a>
      </div>

      <div class="section-heading page-subheading">
        <h2>Подбрани казуси</h2>
      </div>
      <div class="showcase-grid projects-grid">
        {caseStudies.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>

      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>Имаш проект?</h2>
          <p class="page-text">Разкажи ни какво трябва да бъде създадено и какъв резултат търсиш.</p>
        </div>
        <div class="hero-actions">
          <a href={localizeHref(locale, "/contact")} class="button button-primary">Изпрати запитване</a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">Разгледай услугите</a>
        </div>
      </article>
    </section>
  </main>
</Layout>
