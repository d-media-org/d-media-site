---
import Layout from "@/layouts/Layout.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import { type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema } from "@/lib/seo";
import { contactEmail, getSiteContent } from "@/lib/site-content";

const locale: Locale = "bg";
const copy = getPageCopy(locale).contact;
const siteContent = getSiteContent(locale);
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/contact" structuredData={[getBreadcrumbSchema({ locale, path: "/contact", title: copy.metaTitle })]}>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>{copy.title}</h1>
        <p class="page-text">{copy.text}</p>
      </div>
      <div class="section-actions contact-hero-actions">
        <a class="button button-primary" href="#inquiry-form">{copy.primaryCta}</a>
        <p class="contact-microcopy">Не е нужно да имаш готово техническо задание.</p>
      </div>
      <div class="split-content page-grid stacked-cards contact-detail-wrap">
        <div class="card contact-detail-card content-card-wide">
          <h2>{copy.mainContact}</h2>
          <div class="contact-email-row">
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </div>
          <div class="contact-channel-list" aria-label="Социални мрежи">
            {siteContent.socials.map((social) => (
              <a href={social.href} target="_blank" rel="noreferrer" class="contact-channel">
                <span>{social.label}</span>
                <span>{social.handle}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <InquiryForm locale="bg" />
    </section>
  </main>
</Layout>
