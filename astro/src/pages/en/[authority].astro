---
import AuthorityPage from "@/components/AuthorityPage.astro";
import { getAuthorityPages } from "@/lib/authority-pages";
export function getStaticPaths() { return getAuthorityPages("en").map((page) => ({ params: { authority: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<AuthorityPage locale="en" page={page} />
