---
import Layout from "@/layouts/Layout.astro";
import type { Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema } from "@/lib/seo";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "en";
const copy = getPageCopy(locale).about;
const siteContent = getSiteContent(locale);
const brandbookWebHref = "/brandbook_web_exact_en/index.html";
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/about" structuredData={[getBreadcrumbSchema({ locale, path: "/about", title: copy.metaTitle })]}>
  <main class="site-shell" id="top">
    <section class="section-grid about-page">
      <div class="section-heading page-intro">
        <h1><span class="brand-name">d . media</span></h1>
        {copy.introParagraphs.map((paragraph) => <p class="page-text">{paragraph}</p>)}
      </div>
      <div class="split-content page-grid stacked-cards">
        {copy.sectionsBeforeHistory.map((section) => (
          <article class="card about-copy content-card-wide">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        ))}
        <article class="card about-copy content-card-wide">
          <h2>Brand history</h2>
          {siteContent.aboutNotes.map((item) => (
            <section class="history-stage">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </section>
          ))}
        </article>
        {copy.sectionsAfterHistory.map((section) => (
          <article class="card about-copy content-card-wide">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.id === "brandbook" && (
              <div class="hero-actions brandbook-actions">
                <a href={brandbookWebHref} target="_blank" rel="noreferrer" class="button button-secondary desktop-only">
                  {copy.secondaryCta}
                </a>
                <a href="/downloads/d-media-logo-pack.zip" class="button button-secondary" download>
                  Download brand logo and logotype
                </a>
              </div>
            )}
            {section.links && (
              <div class="blog-related-list">
                {section.links.map((link) => <a class="inline-link" href={link.href}>{link.label}</a>)}
              </div>
            )}
          </article>
        ))}
        <article class="card about-copy content-card-wide">
          <h2>{copy.finalTitle}</h2>
          <p>{copy.finalText}</p>
          <div class="hero-actions">
            <a href="/en/contact/" class="button button-primary">{copy.primaryCta}</a>
            <a href="/en/projects/" class="button button-secondary">{copy.workCta}</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .approved-page-content .section-grid.about-page {
    gap: var(--space-24);
  }

  .approved-page-content .section-grid.about-page > .page-grid.stacked-cards {
    padding-block-start: 0;
  }
</style>
