---
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getFeaturedProjects } from "@/lib/featured-projects-static";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getBreadcrumbSchema } from "@/lib/seo";

const locale: Locale = "en";
const caseStudies = getFeaturedProjects(locale);
---

<Layout
  locale={locale}
  title="Case Studies | d . media"
  description="Selected d . media case studies in brand identity, web platforms, graphic design, content, and real application."
  path="/case-studies"
  structuredData={[getBreadcrumbSchema({ locale, path: "/case-studies", title: "Case Studies" })]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>Case Studies</h1>
        <p class="page-text">
          A focused view of projects where identity, content, design, web structure, and application work as one system.
        </p>
      </div>

      <div class="showcase-grid projects-grid">
        {caseStudies.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>

      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>If you need a similar scope, start with context.</h2>
          <p class="page-text">Send what needs to be built, who it is for, and what result you expect.</p>
        </div>
        <div class="hero-actions">
          <a href={localizeHref(locale, "/contact")} class="button button-primary">Describe project</a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">Explore services</a>
        </div>
      </article>
    </section>
  </main>
</Layout>
