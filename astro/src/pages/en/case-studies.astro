---
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getResolvedAllProjectsArchive } from "@/lib/asset-url";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getBreadcrumbSchema } from "@/lib/seo";

const locale: Locale = "en";
const caseStudies = getResolvedAllProjectsArchive(locale).filter((project) => "isCaseStudy" in project && project.isCaseStudy);
---

<Layout
  locale={locale}
  title="Case Studies | d . media"
  description="In-depth stories about selected projects from d . media Work."
  path="/case-studies"
  structuredData={[getBreadcrumbSchema({ locale, path: "/case-studies", title: "Case Studies" })]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>Case Studies</h1>
        <p class="page-text">
          In-depth stories about selected projects from the Work section.
        </p>
        <a class="inline-link" href={localizeHref(locale, "/projects")}>Back to all work</a>
      </div>

      <div class="section-heading page-subheading">
        <h2>Selected case studies</h2>
      </div>
      <div class="showcase-grid projects-grid">
        {caseStudies.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>

      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>Have a project?</h2>
          <p class="page-text">Tell us what needs to be created and what result you are looking for.</p>
        </div>
        <div class="hero-actions">
          <a href={localizeHref(locale, "/contact")} class="button button-primary">Send an inquiry</a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">Explore services</a>
        </div>
      </article>
    </section>
  </main>
</Layout>
