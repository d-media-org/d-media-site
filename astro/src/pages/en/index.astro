---
import BrandAsset from "@/components/BrandAsset.astro";
import BrandText from "@/components/BrandText.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getFeaturedProjects } from "@/lib/featured-projects-static";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { contactEmail, getSiteContent } from "@/lib/site-content";

const locale: Locale = "en";
const copy = getPageCopy(locale).home;
const localizedContent = getSiteContent(locale);
const homepageServices = localizedContent.coreServices.map((service) => ({
  id: service.id,
  title: service.title,
  text: service.text,
}));
const featuredProjects = getFeaturedProjects(locale);
const processSteps = localizedContent.coreProcess;
const aboutSummary = localizedContent.aboutSummary;
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/">
  <main class="site-shell" id="top">
    <section class="hero-grid home-hero">
      <div class="hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="hero-text">
          <BrandText text={copy.text} />
        </p>
        <div class="hero-actions">
          <a
            href={localizeHref(locale, "/contact")}
            class="button button-primary"
            data-ga-event="cta_start_project_click"
            data-ga-location="home_hero"
          >
            {copy.primaryCta}
          </a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">
            {copy.secondaryCta}
          </a>
        </div>
      </div>

      <aside class="hero-panel">
        <div class="hero-card hero-card-brand">
          <div class="brand-image brand-image-brandmark">
            <BrandAsset
              lightSrc="/assets/brand/ONLY-brandmark.png"
              alt={copy.brandmarkAlt}
              width={118}
              height={118}
            />
          </div>
        </div>
        <div class="hero-card hero-card-note">
          <p>{copy.note}</p>
        </div>
      </aside>
    </section>

    <section class="section-grid home-section" id="services">
      <div class="section-heading page-intro-balanced">
        <p class="eyebrow">{copy.servicesEyebrow}</p>
        <h2>{copy.servicesTitle}</h2>
      </div>
      <div class="showcase-grid service-card-grid">
        {homepageServices.map((service) => (
          <article class="card service-category-card">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
      <div class="section-actions">
        <a
          href={localizeHref(locale, "/contact")}
          class="button button-primary"
          data-ga-event="cta_start_project_click"
          data-ga-location="home_services"
        >
          {copy.servicesCta}
        </a>
      </div>
    </section>

    <section class="section-grid home-section" id="pricing">
      <div class="section-heading page-intro-balanced">
        <p class="eyebrow">{copy.pricingEyebrow}</p>
        <h2>{copy.pricingTitle}</h2>
        <p class="page-text">{copy.pricingText}</p>
        <p class="project-meta">{copy.pricingRangeCue}</p>
      </div>
      <div class="showcase-grid project-reading-grid">
        {copy.pricingItems.map((item, index) => (
          <article class={`card package-card${index === 0 ? " is-featured" : ""}`}>
            <h3>{item.title}</h3>
            <p class="package-price">{item.price}</p>
            <p class="project-meta package-value">→ {item.value}</p>
          </article>
        ))}
      </div>
      <div class="section-heading page-subheading">
        <p class="project-meta">{copy.pricingNote}</p>
        <p class="project-meta">{copy.pricingSecondaryNote}</p>
      </div>
      <div class="section-actions">
        <a
          href={localizeHref(locale, "/contact")}
          class="button button-primary"
          data-ga-event="cta_send_inquiry_click"
          data-ga-location="home_pricing"
        >
          {copy.pricingCta}
        </a>
      </div>
    </section>

    <section class="section-grid home-section" id="process">
      <div class="section-heading page-intro-balanced">
        <p class="eyebrow">{copy.processEyebrow}</p>
        <h2>{copy.processTitle}</h2>
      </div>
      <div class="process-timeline">
        {processSteps.map((step) => (
          <article class="card process-step-card">
            <span class="process-step-index">{step.id}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
      <div class="section-actions">
        <a
          href={localizeHref(locale, "/contact")}
          class="button button-primary"
          data-ga-event="cta_send_inquiry_click"
          data-ga-location="home_process"
        >
          {copy.processCta}
        </a>
      </div>
    </section>

    <section class="section-grid home-section" id="projects">
      <div class="section-heading page-intro-balanced">
        <p class="eyebrow">{copy.projectsEyebrow}</p>
        <h2>{copy.projectsTitle}</h2>
        <p class="page-text">{copy.projectsText}</p>
      </div>
      <div class="showcase-grid projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>
      <div class="section-actions">
        <a href={localizeHref(locale, "/projects")} class="button button-secondary">
          {copy.projectsCta}
        </a>
      </div>
    </section>

    <section class="section-grid home-section" id="about">
      <div class="section-heading page-intro-balanced">
        <p class="eyebrow">{copy.aboutEyebrow}</p>
        <h2>
          <BrandText text={copy.aboutTitle} />
        </h2>
      </div>
      <div class="showcase-grid about-summary-grid">
        {aboutSummary.map((item) => (
          <article class="card text-card about-summary-card">
            <p>
              <BrandText text={item} />
            </p>
          </article>
        ))}
      </div>
      <div class="section-actions">
        <a href={localizeHref(locale, "/contact")} class="button button-primary">{copy.aboutCta}</a>
      </div>
    </section>

    <section class="section-grid home-section" id="platform-standard">
      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <p class="eyebrow">{copy.trustEyebrow}</p>
          <h2>{copy.trustTitle}</h2>
          <p class="page-text"><BrandText text={copy.trustText} /></p>
        </div>
        <div class="hero-actions">
          <a href={localizeHref(locale, "/projects/d-media")} class="button button-secondary">
            {copy.trustCta}
          </a>
        </div>
      </article>
    </section>

    <section class="section-grid contact-section home-section" id="contact">
      <div class="card contact-card content-card-wide">
        <p class="eyebrow">{copy.contactEyebrow}</p>
        <h2>{copy.contactTitle}</h2>
        <p class="page-text">{copy.contactText}</p>
        <a href={`mailto:${contactEmail}`} class="contact-email-inline">{contactEmail}</a>
        <div class="hero-actions contact-cta">
          <a
            href={`mailto:${contactEmail}`}
            class="button button-primary"
            data-ga-event="cta_send_inquiry_click"
            data-ga-location="home_contact"
          >
            {copy.contactPrimaryCta}
          </a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">
            {copy.contactSecondaryCta}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
