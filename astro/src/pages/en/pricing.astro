---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getBreadcrumbSchema, getServiceCatalogSchema } from "@/lib/seo";

const locale: Locale = "en";
const corePricingGroups = [
  {
    title: "Branding",
    text: "Identity, mark, logotype, and core visual system.",
    items: [
      { title: "Visual identity", price: "from 699,99 €" },
    ],
  },
  {
    title: "Web Design & Development",
    text: "Websites, landing pages, platforms, integrations, and maintenance.",
    items: [
      { title: "Landing Page", price: "from 690 €" },
      { title: "Portfolio website", price: "from 1 990 €" },
      { title: "Corporate website", price: "from 2 490 €" },
    ],
  },
];
const singlePricingGroups = [
  {
    title: "Branding",
    items: [
      { title: "Logotype design", price: "from 149,99 €" },
      { title: "Logo / brand mark", price: "from 199,99 €" },
    ],
  },
  {
    title: "Content & Social",
    text: "Content, social formats, series, and working channel logic.",
    items: [
      { title: "Social format 1:1 or 9:16", price: "from 24,99 €" },
      { title: "Facebook cover", price: "from 29,99 €" },
      { title: "3x visual package", price: "from 69,99 €" },
    ],
  },
  {
    title: "Print & Digital Design",
    text: "Print, digital, and informational materials for real use.",
    items: [
      { title: "Single-sided business card", price: "from 24,99 €" },
      { title: "Flyer / brochure", price: "from 39,99 €" },
      { title: "Menu or multipage material", price: "from 69,99 €" },
    ],
  },
];
const rightsAndConditions = [
  { title: "White-label execution / no author credit", price: "from 19,99 €" },
  { title: "Non-exclusive usage licence", price: "from 49,99 €" },
  { title: "Exclusive licence", price: "from 99,99 €" },
  { title: "Full transfer of economic rights by individual agreement", price: "from 2799 €" },
  { title: "Priority timeline", price: "from +25%" },
];
---

<Layout
  locale={locale}
  title="Starting ranges | d . media"
  description="Starting pricing ranges for brand identity, content, social media, design, web development, rights, and white-label services."
  path="/pricing"
  structuredData={[
    getBreadcrumbSchema({ locale, path: "/pricing", title: "Starting ranges" }),
    getServiceCatalogSchema(locale),
  ]}
>
  <main class="site-shell services-page pricing-page" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>Starting ranges</h1>
        <p class="page-text">
          Starting ranges for core <BrandText text="d . media" /> services. Final scope is aligned around project scale, timing, formats, rights, and complexity.
        </p>
      </div>

      <div class="section-heading page-subheading">
        <h2>How to read the starting ranges</h2>
        <p class="pricing-guidance">All values are starting ranges, not final prices. Final scope is confirmed after a short review of the project.</p>
        <p class="page-text">Single-item entries refer to a specific piece of work; +25% is a percentage charge; full transfer of economic rights is agreed individually.</p>
      </div>

      <div class="section-heading page-subheading">
        <h2>Core services and larger scopes</h2>
      </div>
      {corePricingGroups.map((group) => (
        <>
          <div class="section-heading page-subheading">
            <h3>{group.title}</h3>
            <p class="page-text">{group.text}</p>
          </div>
          <div class="showcase-grid project-reading-grid">
            {group.items.map((item) => (
              <article class="card package-card">
                <h4>{item.title}</h4>
                <p class="package-price">{item.price}</p>
              </article>
            ))}
          </div>
        </>
      ))}

      <div class="section-heading page-subheading">
        <h2>Single items</h2>
      </div>
      {singlePricingGroups.map((group) => (
        <>
          <div class="section-heading page-subheading">
            <h3>{group.title}</h3>
            {group.text && <p class="page-text">{group.text}</p>}
          </div>
          <div class="showcase-grid project-reading-grid">
            {group.items.map((item) => (
              <article class="card package-card">
                <h4>{item.title}</h4>
                <p class="package-price">{item.price}</p>
              </article>
            ))}
          </div>
        </>
      ))}

      <div class="section-heading page-subheading">
        <h2>Rights, working modes, and additional conditions</h2>
        <p class="page-text">No-author-credit execution is a working mode; licences and rights transfers concern usage rights; priority timing is an additional charge.</p>
      </div>
      <div class="showcase-grid project-reading-grid">
        {rightsAndConditions.map((item) => (
          <article class="card package-card">
            <h3>{item.title}</h3>
            <p class="package-price">{item.price}</p>
          </article>
        ))}
      </div>

      <section class="pricing-faq" aria-labelledby="pricing-faq-title">
        <h2 id="pricing-faq-title">Questions and next step</h2>
        <article class="card services-cta-card">
          <div class="services-cta-copy">
            <h3>Discuss your project with d . media.</h3>
          </div>
          <div class="hero-actions">
            <a href={localizeHref(locale, "/contact")} class="button button-primary">Contact us</a>
            <a href={localizeHref(locale, "/services")} class="button button-secondary">Explore services</a>
          </div>
        </article>
        <h3>How is the final price determined?</h3>
        <details>
          <summary>What changes the starting range?</summary>
          <p>Content, complexity, volume, timing, integrations, rights, and required support.</p>
        </details>
        <details>
          <summary>Do I need a finished brief?</summary>
          <p>No. Send the goal, available materials, and the next step you need.</p>
        </details>
      </section>

      <div class="project-card-footer">
        <a class="inline-link" href={localizeHref(locale, "/legal/policies")}>Operational policies</a>
      </div>
    </section>
  </main>
</Layout>
