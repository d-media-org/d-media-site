---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getAuthorityServices } from "@/lib/authority-services";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema, getServiceCatalogSchema } from "@/lib/seo";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "en";
const copy = getPageCopy(locale).services;
const siteContent = getSiteContent(locale);
type CatalogEntry = {
  id: string;
  title: string;
  text: string;
  detailHref: string;
  detailLabel: string;
  includes?: string;
  audience?: string;
  result?: string;
};
const catalogEntries: CatalogEntry[] = siteContent.coreServices
  .filter((service) => service.id !== "additional-charges-rights" && "detailHref" in service)
  .map((service) => ({ ...service, detailHref: service.detailHref, detailLabel: service.detailLabel }));
catalogEntries.push(
  ...getAuthorityServices(locale)
    .filter((service) => service.slug === "web-design" || service.slug === "web-development")
    .map((service) => ({
      id: service.slug,
      title: service.title,
      text: service.intro,
      detailHref: `/services/${service.slug}`,
      detailLabel: service.slug === "web-design" ? "View web design scope" : "View web development scope",
    })),
);
const catalogById = Object.fromEntries(catalogEntries.map((service) => [service.id, service]));
const serviceGroups = [
  { title: "Brand & Design", primaryId: "brand-identity", items: [{ id: "graphic-design" }] },
  {
    title: "Content & Communication",
    primaryId: "content",
    items: [
      { id: "social-media-management" },
      { id: "advertising" },
    ],
  },
  {
    title: "Web",
    primaryId: "web-design-development",
    items: [
      { id: "web-design" },
      { id: "web-development" },
    ],
  },
  {
    title: "Visibility & Support",
    items: [
      { id: "technical-seo" },
      { id: "geo" },
      { id: "performance-optimization" },
      { id: "technical-support" },
    ],
  },
];
const rightsEntry = siteContent.coreServices.find((service) => service.id === "additional-charges-rights");
const serviceIconPaths: Record<string, string> = {
  "brand-identity": "M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 4.5v8m-4-4h8",
  "graphic-design": "M5 5h14v14H5zM9 9h6v6H9z",
  "content": "M5 6h14M5 12h10M5 18h14",
  "social-media-management": "M7 7h3v3H7zM14 14h3v3h-3zM10 9.5l4 5",
  "advertising": "M5 11h4l6-4v10l-6-4H5zM8 15v4",
  "web-design-development": "M4 5h16v14H4zM4 9h16M8 7h.01M11 7h.01",
  "technical-seo": "m10 5 5 5-5 5M5 19l4-4M14 19h5v-5",
  "geo": "M12 21s6-4.3 6-10A6 6 0 0 0 6 11c0 5.7 6 10 6 10Zm0-12.5h.01",
  "performance-optimization": "M5 17a7 7 0 1 1 14 0M12 10l3 3",
  "technical-support": "M8 18h8M9 18v-3a3 3 0 0 1 6 0v3M6 12v-2a6 6 0 0 1 12 0v2",
  "additional-charges-rights": "M12 5v14M5 12h14",
};
---

<Layout
  locale={locale}
  title={`${copy.metaTitle} | d . media`}
  description={copy.metaDescription}
  path="/services"
  structuredData={[
    getBreadcrumbSchema({ locale, path: "/services", title: copy.metaTitle }),
    getServiceCatalogSchema(locale),
  ]}
>
  <main class="site-shell services-page" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>{copy.title}</h1>
        <p class="page-text">
          <BrandText text={copy.text} />
        </p>
      </div>
      {serviceGroups.map((group) => (
        <section class="page-subheading">
          <h2>{group.title}</h2>
          {group.primaryId && catalogById[group.primaryId] ? (
            <article class="card service-category-card">
              <span class="mp-service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={serviceIconPaths[group.primaryId]} /></svg>
              </span>
              <h3>{catalogById[group.primaryId].title}</h3>
              <p>{catalogById[group.primaryId].text}</p>
              {catalogById[group.primaryId].includes ? <p><strong>{copy.includes}:</strong> {catalogById[group.primaryId].includes}</p> : null}
              {catalogById[group.primaryId].audience ? <p><strong>{copy.audience}:</strong> {catalogById[group.primaryId].audience}</p> : null}
              {catalogById[group.primaryId].result ? <p><strong>{copy.result}:</strong> {catalogById[group.primaryId].result}</p> : null}
              <a class="inline-link" href={localizeHref(locale, catalogById[group.primaryId].detailHref)}>{catalogById[group.primaryId].detailLabel}</a>
            </article>
          ) : null}
          {group.items.length > 0 ? (
            <ul>
              {group.items.map((item) => {
                const service = catalogById[item.id];
                return service ? (
                  <li>
                    <a class="inline-link" href={localizeHref(locale, service.detailHref)}>{service.title}</a>
                    <p>{service.text}</p>
                  </li>
                ) : null;
              })}
            </ul>
          ) : null}
        </section>
      ))}
      {rightsEntry ? (
        <aside class="page-subheading">
          <h2>Scope, rights & additional conditions</h2>
          <p>{rightsEntry.text}</p>
          <a class="inline-link" href={localizeHref(locale, rightsEntry.detailHref)}>{rightsEntry.detailLabel}</a>
        </aside>
      ) : null}
      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>{copy.ctaTitle}</h2>
          <p class="page-text">{copy.ctaText}</p>
        </div>
        <div class="hero-actions">
          <a
            href={localizeHref(locale, "/contact")}
            class="button button-primary"
            data-ga-event="cta_start_project_click"
            data-ga-location="services_cta"
          >
            {copy.primaryCta}
          </a>
          <a href={localizeHref(locale, "/projects")} class="button button-secondary">
            {copy.secondaryCta}
          </a>
        </div>
      </article>
    </section>
  </main>
</Layout>
