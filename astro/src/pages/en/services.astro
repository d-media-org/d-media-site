---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema, getServiceCatalogSchema } from "@/lib/seo";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "en";
const copy = getPageCopy(locale).services;
const siteContent = getSiteContent(locale);
const serviceById = new Map(siteContent.coreServices.map((service) => [service.id, service]));
const serviceGroups = [
  { title: "Brand and design", text: "Identity, graphic materials, and clear rules for applying the brand consistently.", services: ["brand-identity", "graphic-design"] },
  { title: "Content and communication", text: "Copy, visual formats, social channels, and advertising organised around a real communication goal.", services: ["content", "social-media-management", "advertising"] },
  { title: "Web", text: "Websites and digital platforms with clear structure, appropriate technology, sound performance, and room to develop.", services: ["web-design-development"] },
  { title: "Visibility and support", text: "A technical foundation for search engines and AI systems, performance, and ongoing technical care.", services: ["technical-seo", "geo", "performance-optimization", "technical-support"] },
].map((group) => ({ ...group, services: group.services.map((id) => serviceById.get(id)).filter(Boolean) }));
---

<Layout
  locale={locale}
  title={`${copy.metaTitle} | d . media`}
  description={copy.metaDescription}
  path="/services"
  structuredData={[
    getBreadcrumbSchema({ locale, path: "/services", title: copy.metaTitle }),
    getServiceCatalogSchema(locale),
  ]}
>
  <main class="site-shell services-page" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>{copy.title}</h1>
        <p class="page-text">
          <BrandText text={copy.text} />
        </p>
      </div>
      {serviceGroups.map((group) => (
        <section class="section-grid">
          <div class="section-heading page-subheading">
            <h2>{group.title}</h2>
            <p class="page-text">{group.text}</p>
          </div>
          <div class="showcase-grid service-card-grid">
            {group.services.map((service) => service && (
              <article class="card service-category-card">
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <p><strong>{copy.includes}:</strong> {service.includes}</p>
                <p><strong>{copy.audience}:</strong> {service.audience}</p>
                <p><strong>{copy.result}:</strong> {service.result}</p>
                <a class="inline-link" href={localizeHref(locale, service.detailHref)}>{service.detailLabel}</a>
              </article>
            ))}
          </div>
        </section>
      ))}
      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>{copy.ctaTitle}</h2>
          <p class="page-text">{copy.ctaText}</p>
        </div>
        <div class="hero-actions">
          <a
            href={localizeHref(locale, "/contact")}
            class="button button-primary"
            data-ga-event="cta_start_project_click"
            data-ga-location="services_cta"
          >
            {copy.primaryCta}
          </a>
          <a href={localizeHref(locale, "/projects")} class="button button-secondary">
            {copy.secondaryCta}
          </a>
        </div>
      </article>
    </section>
  </main>
</Layout>
