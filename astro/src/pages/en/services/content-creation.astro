---
import ServiceDetailPage from "@/components/ServiceDetailPage.astro";
import { type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";

const locale: Locale = "en";
const baseCopy = getPageCopy(locale).contentService;
const copy = {
  ...baseCopy,
  metaTitle: "Content Creation",
  metaDescription:
    "Content creation for brands: copy, visual formats, post series, content structure, and a clear communication line.",
  title: "Content Creation",
  intro:
    "We create content that organises message, visual order, and real use across websites, social channels, and campaigns.",
  pricingTitle: "Starting ranges for content scope.",
  pricingText:
    "Content scope is shaped around number of formats, copy work, visual series, and frequency. The social visual formats below provide a starting framework for the first working scope.",
  ctaTitle: "If the content needs to sound and look consistent, start here.",
  ctaText:
    "Send channels, topics, required formats, frequency, and available materials. From there we align the content scope.",
  primaryCta: "Send content context",
};
const path = "/services/content-creation";
---

<ServiceDetailPage locale={locale} path={path} copy={copy} ctaLocation="content_creation_service_cta" />
