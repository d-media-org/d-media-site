---
import Layout from "@/layouts/Layout.astro";

const sections = [
  ["Project foundation", "The first complete website established the core pages, d . media visual system, bilingual foundation, and initial portfolio."],
  ["Portfolio and project presentation", "The portfolio grew into a curated collection of projects, real applications, case studies, and motion work with consistent desktop and mobile presentation."],
  ["Content, services, and pricing", "Dedicated service pages, starting pricing ranges, practical articles, and clearer inquiry paths expanded the website beyond a portfolio."],
  ["Production platform", "The production website moved to Astro and Cloudflare Pages, improving speed, stability, accessibility, and publishing reliability."],
  ["Contact system", "A protected inquiry flow added reliable storage, transactional email, CRM synchronization, and a structured project brief without automatic newsletter subscription."],
  ["Project estimation", "A bilingual consultation tool now combines services, scope, budget, timeline, dependencies, readiness, confidence, and a ready-to-send project brief."],
] as const;
---

<Layout
  locale="en"
  title="Site history | d . media"
  description="A concise history of the substantial changes published on d . media."
  path="/site-history"
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>Site history</h1>
        <p class="page-text">A concise record of substantial changes that reached the production website.</p>
        <p class="page-text history-version-switch">
          <a class="inline-link is-active" href="/en/site-history/">Summary version</a>
          <a class="inline-link" href="/en/site-history/daily/">Full version</a>
        </p>
      </header>
      <nav class="card history-index history-index-static" aria-label="Contents">
        <ul>{sections.map(([title], index) => <li><a href={`#stage-${index + 1}`}>{title}</a></li>)}</ul>
      </nav>
      <article class="card text-card history-content is-revealed">
        {sections.map(([title, text], index) => (
          <section class="history-stage">
            <h2 id={`stage-${index + 1}`}>{title}</h2>
            <p>{text}</p>
          </section>
        ))}
      </article>
    </section>
  </main>
</Layout>
