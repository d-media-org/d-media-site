---
import Layout from "@/layouts/Layout.astro";

const sections = [
  ["Platform beginnings", "The website began as a public home for core information and an initial portfolio. It brought the brand, services, and completed work together."],
  ["A broader structure", "The platform expanded with dedicated service pages, starting price ranges, and inquiry paths. Visitors could move from an overview to a specific area of work."],
  ["Work and knowledge", "Projects and case studies were joined by a bilingual blog and knowledge base. The website began presenting both visual work and practical subject matter around it."],
  ["Technology evolution", "The public platform moved to Astro and statically generated pages. This describes a technical stage in the website's development, not a guarantee of specific outcomes."],
  ["Astro and Cloudflare Pages", "The current website is built with Astro and published through Cloudflare Pages. Preview and public publishing environments are kept separate."],
  ["Performance and quality", "Earlier project documentation records scores of 98 / 100 / 100 / 100 for mobile and 100 / 100 / 100 / 100 for desktop. No dated primary report is available; these are not current measurements or a permanent guarantee."],
  ["SEO, GEO, and AI visibility", "The content and technical structure have developed to include canonical URLs, language alternates, structured data, a sitemap, and machine-readable files. These choices do not guarantee search rankings or citations by AI systems."],
  ["The platform today", "Today, d-media.org is a bilingual platform for services, projects and case studies, starting price ranges, articles, the knowledge base, and inquiries. The platform continues to develop around this content structure."],
] as const;
---

<Layout
  locale="en"
  title="Platform history | d . media"
  description="Stages in the development of d-media.org as a public digital platform."
  path="/site-history"
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>Platform history</h1>
        <p class="page-text">Stages in the development of d-media.org, separate from the brand story and the internal change log.</p>
        <p class="page-text history-version-switch">
          <a class="inline-link is-active" href="/en/site-history/">Overview</a>
          <a class="inline-link" href="/en/site-history/daily/">Expanded overview</a>
        </p>
      </header>
      <nav class="card history-index history-index-static" aria-label="Contents">
        <ul>{sections.map(([title], index) => <li><a href={`#stage-${index + 1}`}>{title}</a></li>)}</ul>
      </nav>
      <article class="card text-card history-content is-revealed">
        {sections.map(([title, text], index) => (
          <section class="history-stage">
            <h2 id={`stage-${index + 1}`}>{title}</h2>
            <p>{text}</p>
          </section>
        ))}
      </article>
    </section>
  </main>
</Layout>
