---
import Layout from "@/layouts/Layout.astro";

const sections = [
  ["Platform beginnings", "The website began as a public home with core pages and an initial portfolio.", "The first structure brought the brand, services, and projects together and provided a foundation for bilingual development."],
  ["A broader structure", "The platform expanded from a presentation website into a fuller system of services and content.", "Dedicated service pages, starting price ranges, and clearer inquiry paths were added. Navigation and internal links connect these parts."],
  ["Work and knowledge", "Projects and case studies were gradually joined by editorial content.", "The blog and knowledge base have distinct roles and URLs. Articles, projects, and case studies are connected by topic without mixing in unpublished drafts."],
  ["Technology evolution", "The public website moved from an earlier web architecture to Astro and statically generated pages.", "This changed how the platform is built. The technology choice is not presented as proof of business outcomes or a specific measurement."],
  ["Astro and Cloudflare Pages", "The current platform uses Astro for its pages and Cloudflare Pages for publishing them.", "Preview and public publishing workflows are separate. The website is bilingual and generated as static content."],
  ["Performance and quality", "Earlier project documentation records scores of 98 / 100 / 100 / 100 for mobile and 100 / 100 / 100 / 100 for desktop.", "These values come from earlier documentation, not a dated primary report. They are not current measurements, do not prove a permanent state, and are not a guarantee."],
  ["SEO, GEO, and AI visibility", "The technical and content structure includes canonical URLs, language alternates, structured data, a sitemap, and machine-readable files.", "The aim is consistent and accessible public information. Search rankings and source selection by search engines or AI systems cannot be guaranteed."],
  ["The platform today", "d-media.org presents services, projects, case studies, starting price ranges, a blog, a knowledge base, and an inquiry form.", "The platform also includes a bilingual project estimator that passes selected details to the contact form. This public account describes stages and product structure, not an internal change log."],
] as const;
---

<Layout
  locale="en"
  title="Expanded platform history | d . media"
  description="A detailed overview of the stages in d-media.org's development as a public platform."
  path="/site-history/daily"
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>Platform history</h1>
        <p class="page-text">The <a class="inline-link" href="/en/site-history/">overview</a> offers a short introduction; this page describes development in more detail by stage.</p>
        <p class="page-text history-version-switch">
          <a class="inline-link" href="/en/site-history/">Overview</a>
          <a class="inline-link is-active" href="/en/site-history/daily/">Expanded overview</a>
        </p>
      </header>
      <article class="card text-card history-content is-revealed">
        {sections.map(([title, summary, detail], index) => (
          <section class="history-stage">
            <h2 id={`stage-${index + 1}`}>{title}</h2>
            <p>{summary}</p>
            <p>{detail}</p>
          </section>
        ))}
      </article>
    </section>
  </main>
</Layout>
