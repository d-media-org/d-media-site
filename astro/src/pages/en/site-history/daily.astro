---
import Layout from "@/layouts/Layout.astro";

const sections = [
  ["March 2026", "Published the first complete website, then expanded its project presentation, bilingual structure, visual hierarchy, and mobile behavior."],
  ["April 2026", "Improved navigation, brand consistency, image presentation, and the overall rhythm of the primary public pages."],
  ["May 2026", "Expanded service content, search architecture, internal navigation, accessibility, performance, and platform stability."],
  ["June 2026", "Moved the production website to Astro and Cloudflare Pages; published the bilingual knowledge base, detailed services, pricing, case studies, protected inquiry system, and project estimation experience."],
] as const;
---

<Layout
  locale="en"
  title="Full site history | d . media"
  description="A chronological record of substantial changes published on d . media."
  path="/site-history/daily"
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>Site history</h1>
        <p class="page-text">This view contains only substantial changes confirmed on the production website.</p>
        <p class="page-text history-version-switch">
          <a class="inline-link" href="/en/site-history/">Summary version</a>
          <a class="inline-link is-active" href="/en/site-history/daily/">Full version</a>
        </p>
      </header>
      <article class="card text-card history-content is-revealed">
        {sections.map(([period, text], index) => (
          <section class="history-stage">
            <h2 id={`period-${index + 1}`}>{period}</h2>
            <p>{text}</p>
          </section>
        ))}
      </article>
    </section>
  </main>
</Layout>
