---
import Layout from "@/layouts/Layout.astro";
import ProjectEstimator from "@/components/ProjectEstimator.astro";
import { getBreadcrumbSchema } from "@/lib/seo";
---
<Layout locale="bg" title="Оценка на проект | d . media" description="Получете ориентировъчна оценка за инвестицията, обхвата и срока на Вашия проект." path="/estimator" structuredData={[getBreadcrumbSchema({locale:"bg",path:"/estimator",title:"Оценка на проект"})]}>
  <main class="site-shell estimator-page" id="top"><section class="section-grid">
    <div class="section-heading page-intro"><p class="eyebrow">конфигуратор на проект</p><h1>Оценка на проект</h1><p class="page-text">Получете ориентировъчна оценка за инвестицията, обхвата и срока на Вашия проект.</p><div class="hero-actions"><a href="#estimator" class="button button-primary">Започнете</a></div></div>
    <div id="estimator"><ProjectEstimator locale="bg" /></div>
  </section></main>
</Layout>
