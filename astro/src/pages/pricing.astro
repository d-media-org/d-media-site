---
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getBreadcrumbSchema, getServiceCatalogSchema } from "@/lib/seo";

const locale: Locale = "bg";
const pricingGroups = [
  {
    title: "Бранд идентичност",
    text: "Име, знак, логотип и базова визуална система, които правят бранда разпознаваем.",
    items: [
      { title: "Дизайн на логотип", price: "от 149,99 €", includes: "Дизайн на текстов знак според договорената посока.", excludes: "Илюстративен символ, пълна идентичност и приложения извън договореното.", factors: "Броят посоки, нужните проверки, вариантите и приложението на знака.", deliverable: "Финален логотип в договорените файлови формати." },
      { title: "Лого / брандмарк", price: "от 199,99 €", includes: "Дизайн на визуален знак за договорената употреба.", excludes: "Пълна визуална система, допълнителни материали и регистрация на марка.", factors: "Сложността на знака, вариантите, проверките и нужните приложения.", deliverable: "Финален знак в договорените файлови формати." },
      { title: "Визуална идентичност", price: "от 699,99 €", includes: "Основен знак, цветова и типографска рамка и договорените базови правила.", excludes: "Неограничен брой приложения, печатни производства и работа извън договорения пакет.", factors: "Броят приложения, вариантите, обхватът на правилата и нужната подготовка.", deliverable: "Договорените финални файлове и насоки за употреба." },
    ],
  },
  {
    title: "Съдържание и социални мрежи",
    text: "Текстове, визии, серии публикации и подредена логика за комуникация в каналите.",
    items: [
      { title: "Формат за социални мрежи 1:1 или 9:16", price: "от 24,99 €", includes: "Една визия в избрания формат, подготвена по предоставено съдържание.", excludes: "Текстова стратегия, снимки, видео, анимация и допълнителни адаптации.", factors: "Сложността на визията, изходните материали и броят корекции.", deliverable: "Финален файл за избрания социален формат." },
      { title: "Корица за Facebook", price: "от 29,99 €", includes: "Една корица, съобразена с договореното съдържание и формата на Facebook.", excludes: "Копирайтинг, фотография, серия от визии и адаптации за други канали.", factors: "Сложността на композицията, материалите и броят корекции.", deliverable: "Финален файл за Facebook cover." },
      { title: "Пакет 3x визии", price: "от 69,99 €", includes: "Три договорени статични визии в обща комуникационна посока.", excludes: "Календар, публикуване, видео, анимация и неуговорени формати.", factors: "Броят адаптации, сложността на всяка визия и готовността на материалите.", deliverable: "Три финални файла в договорените формати." },
    ],
  },
  {
    title: "Печатен и дигитален дизайн",
    text: "Печатни, дигитални и информационни материали за реална употреба.",
    items: [
      { title: "Едностранна визитка", price: "от 24,99 €", includes: "Дизайн на една страна на визитка по предоставени данни.", excludes: "Двустранна версия, печат, редакция на съдържание и допълнителни формати.", factors: "Наличието на лого и данни, сложността на композицията и корекциите.", deliverable: "Файл за печат в договорения формат." },
      { title: "Флаер / брошура", price: "от 39,99 €", includes: "Дизайн на флаер или брошура в договорения начален формат.", excludes: "Печат, фотография, копирайтинг, многостраничен обхват и неуговорени адаптации.", factors: "Броят страни, съдържанието, изображенията и подготовката за печат.", deliverable: "Финален файл за договорения печатен или дигитален формат." },
      { title: "Меню или многостраничен материал", price: "от 69,99 €", includes: "Начална структура и дизайн на меню или многостраничен материал.", excludes: "Неограничен брой страници, печат, редакция на текстове и снимане.", factors: "Броят страници, езиковите версии, таблиците, изображенията и корекциите.", deliverable: "Финален файл в договорения формат и страници." },
    ],
  },
  {
    title: "Уеб дизайн и разработка",
    text: "Сайтове, страници за кампания или услуга, платформи, свързване със системи и поддръжка.",
    items: [
      { title: "Страница за кампания или услуга", price: "от 690 €", includes: "Структура, дизайн и разработка на една страница с договорени секции.", excludes: "Копирайтинг, фотография, сложни интеграции, реклама и последваща поддръжка.", factors: "Броят секции, съдържанието, формите, интеграциите и срокът.", deliverable: "Публикувана или готова за публикуване адаптивна страница." },
      { title: "Портфолио сайт", price: "от 1 990 €", includes: "Структура, дизайн и разработка за договорения брой страници и проекти.", excludes: "Неограничено въвеждане на съдържание, външни системи, хостинг и поддръжка.", factors: "Броят страници и проекти, галериите, езиковите версии и интеграциите.", deliverable: "Адаптивен портфолио сайт с договореното съдържание." },
      { title: "Корпоративен уеб сайт", price: "от 2 490 €", includes: "Информационна структура, дизайн и разработка на договорения корпоративен обхват.", excludes: "Копирайтинг, фотография, външни лицензи, сложни интеграции и текуща поддръжка.", factors: "Броят шаблони и страници, езиците, CMS нуждите, интеграциите и миграцията.", deliverable: "Адаптивен корпоративен сайт в договорения обхват." },
    ],
  },
  {
    title: "Видимост и поддръжка",
    text: "Техническо SEO, GEO, производителност и поддръжка се определят след преглед на текущото състояние, целите и необходимата работа.",
    items: [
      { title: "Техническо SEO", price: "По индивидуален обхват", includes: "Технически преглед и договорени корекции по обхождане, индексиране и структура.", excludes: "Гарантирано класиране, рекламни бюджети и работа извън договорения сайт.", factors: "Текущото състояние, броят страници, системата и нужните корекции.", deliverable: "Документиран преглед и договорените технически промени." },
      { title: "GEO и видимост в системи с изкуствен интелект", price: "По индивидуален обхват", includes: "Преглед на публичното описание, съдържателната структура и договорените подобрения.", excludes: "Гарантирано цитиране, класиране или контрол върху отговорите на AI системи.", factors: "Наличните сигнали, съдържанието, техническата основа и необходимият обхват.", deliverable: "Договорени промени и ясни ограничения на работата." },
      { title: "Оптимизация на производителността", price: "По индивидуален обхват", includes: "Измерване на текущото състояние и договорени приоритетни оптимизации.", excludes: "Гарантиран фиксиран PageSpeed резултат и промени извън договорения технически обхват.", factors: "Платформата, assets, integrations, текущите показатели и нужните тестове.", deliverable: "Проверени договорени оптимизации и резултати от измерването." },
      { title: "Техническа поддръжка", price: "По индивидуален обхват", includes: "Договорен ритъм за обновявания, корекции, диагностика и контролирани публикации.", excludes: "Нови големи функции, външни лицензи и работа извън договорените часове или обхват.", factors: "Платформата, достъпите, приоритетът, честотата и натрупаният технически риск.", deliverable: "Проследими договорени промени и проверка преди публикуване." },
    ],
  },
];
---

<Layout
  locale={locale}
  title="Цени и начални рамки | d . media"
  description="Начални цени и индивидуални обхвати за бранд идентичност, съдържание, дизайн, уеб разработка, видимост и техническа поддръжка."
  path="/pricing"
  structuredData={[
    getBreadcrumbSchema({ locale, path: "/pricing", title: "Цени и начални рамки" }),
    getServiceCatalogSchema(locale),
  ]}
>
  <main class="site-shell services-page" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>Цени и начални рамки</h1>
        <p class="page-text">
          Публикуваме начални цени там, където услугата може да бъде описана с достатъчно ясен стандартен обхват. При по-сложни проекти цената се определя след преглед на задачата.
        </p>
        <p class="pricing-guidance">Всички стойности са начални рамки, а не крайна цена. Финалният обхват се потвърждава след кратък преглед на проекта.</p>
      </div>

      {pricingGroups.map((group) => (
        <>
          <div class="section-heading page-subheading">
            <h2>{group.title}</h2>
            <p class="page-text">{group.text}</p>
          </div>
          <div class="showcase-grid project-reading-grid">
            {group.items.map((item) => (
              <article class="card package-card">
                <h3>{item.title}</h3>
                <p class="package-price">{item.price}</p>
                <dl class="pricing-details">
                  <div><dt>Какво включва</dt><dd>{item.includes}</dd></div>
                  <div><dt>Какво не включва</dt><dd>{item.excludes}</dd></div>
                  <div><dt>Какво може да промени цената</dt><dd>{item.factors}</dd></div>
                  <div><dt>Какво получаваш</dt><dd>{item.deliverable}</dd></div>
                </dl>
              </article>
            ))}
          </div>
        </>
      ))}

      <p class="pricing-guidance">Външни разходи като рекламни бюджети, домейни, хостинг, платени лицензи, платени ресурси и услуги на трети страни не са включени, освен ако не са изрично посочени в офертата.</p>

      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>Цената следва реалния обхват.</h2>
          <p class="page-text">Опиши проекта, нужните формати и срока. Ще върнем подредена рамка за работа.</p>
        </div>
        <div class="hero-actions">
          <a href={localizeHref(locale, "/contact")} class="button button-primary">Изпрати запитване</a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">Разгледай услугите</a>
        </div>
      </article>

      <section class="pricing-faq" aria-labelledby="pricing-faq-title">
        <h2 id="pricing-faq-title">Как се определя финалната цена?</h2>
        <details>
          <summary>Какво променя началната рамка?</summary>
          <p>Съдържанието, сложността, обемът, срокът, интеграциите, правата и нужната поддръжка.</p>
        </details>
        <details>
          <summary>Трябва ли да имам готово техническо задание?</summary>
          <p>Не. Опиши целта, наличните материали и желаната следваща стъпка.</p>
        </details>
        <details>
          <summary>Каква е следващата стъпка?</summary>
          <p>Изпрати запитване. След прегледа ще бъде подредена по-точна рамка за работа.</p>
        </details>
      </section>

      <div class="project-card-footer">
        <a class="inline-link" href="/legal/policies/">Оперативни политики</a>
      </div>
    </section>
  </main>
</Layout>
