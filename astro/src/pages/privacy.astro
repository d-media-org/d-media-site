---
import BrandText from "@/components/BrandText.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPrivacyPolicy } from "@/lib/legal-content";
import { getPageCopy } from "@/lib/page-copy";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "bg";
const copy = getPageCopy(locale).privacy;
const siteContent = getSiteContent(locale);
const fullPolicySections = getPrivacyPolicy(locale);
const backLabel = "обратно към контактите";
const formatSectionHeading = (id: string, title: string) => {
  const heading = `${id}. ${title}`;
  return /^\d+$/.test(id) ? heading.toUpperCase() : heading;
};
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/privacy">
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>{copy.title}</h1>
        <p class="page-text"><BrandText text={copy.text} /></p>
        <div class="project-card-footer">
          <a class="inline-link" href={localizeHref(locale, "/contact")}>{backLabel}</a>
        </div>
      </div>

      <div class="card">
        <ul class="policy-list">
          {siteContent.privacySummary.map((item) => (
            <li><BrandText text={item} /></li>
          ))}
        </ul>
      </div>

      <div class="showcase-grid definition-grid">
        {siteContent.privacySections.map((section) => (
          <article class="card package-card">
            <h3>{section.title}</h3>
            <p><BrandText text={section.text} /></p>
          </article>
        ))}
      </div>

      <details class="card privacy-details">
        <summary>{copy.full}</summary>
        <div class="privacy-details-copy">
          <p>{copy.policyTitle}</p>
          {fullPolicySections.map((section) => (
            <section class="privacy-section">
              {section.title ? <h3>{formatSectionHeading(section.id, section.title)}</h3> : null}
              {section.content?.map((paragraph) => (
                <p><BrandText text={paragraph} /></p>
              ))}
              {section.bullets ? (
                <ul class="privacy-bullets">
                  {section.bullets.map((bullet) => (
                    <li><BrandText text={bullet} /></li>
                  ))}
                </ul>
              ) : null}
              {section.subsections?.map((subsection) => (
                <section class="privacy-section">
                  {subsection.title ? <h3>{subsection.id}. {subsection.title}</h3> : null}
                  {subsection.content?.map((paragraph) => (
                    <p><BrandText text={paragraph} /></p>
                  ))}
                  {subsection.bullets ? (
                    <ul class="privacy-bullets">
                      {subsection.bullets.map((bullet) => (
                        <li><BrandText text={bullet} /></li>
                      ))}
                    </ul>
                  ) : null}
                </section>
              ))}
              {section.tail?.map((paragraph) => (
                <p><BrandText text={paragraph} /></p>
              ))}
            </section>
          ))}
        </div>
      </details>

      <div class="project-card-footer">
        <a class="inline-link" href={localizeHref(locale, "/contact")}>{backLabel}</a>
      </div>
    </section>
  </main>
</Layout>
