---
import BrandText from "@/components/BrandText.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { getResolvedLegacyMockupCollections, getResolvedProjectPngArchive } from "@/lib/asset-url";
import { getFeaturedProjectSlugs, getFeaturedProjects } from "@/lib/featured-projects-static";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getBreadcrumbSchema } from "@/lib/seo";

const locale: Locale = "bg";
const copy = getPageCopy(locale).projects;
const resolvedProjectPngArchive = getResolvedProjectPngArchive(locale);
const legacyMockupCollections = getResolvedLegacyMockupCollections(locale);
const featuredProjectSlugs = getFeaturedProjectSlugs();
const featuredProjects = getFeaturedProjects(locale);
const archiveProjects = resolvedProjectPngArchive.filter(
  (project) => !featuredProjectSlugs.includes(project.slug as (typeof featuredProjectSlugs)[number]),
);
const portraitLegacyMockupPaths = new Set([
  "/optimized-assets/project-web/a5954d06a2b4-481903080-2724640101061731-1049849463403877498-n.webp",
  "/optimized-assets/project-web/1d7ad868d9cd-481159328-2724640094395065-5692584808678090360-n.webp",
  "/optimized-assets/project-web/e4b931a413e7-481332918-2724640057728402-2347982715872970579-n.webp",
  "/optimized-assets/project-web/deb2f780f556-481260778-2724640077728400-882415871851379020-n.webp",
  "/optimized-assets/project-web/7bb41c42930f-05apr-addicted-to-music-h.webp",
  "/optimized-assets/project-web/628ca7e51e24-12jan-music-addiction.webp",
  "/optimized-assets/project-web/811ca5e4f888-22-23dec-opium-night-bar.webp",
  "/optimized-assets/project-web/4f842207c627-27500177-794592694066491-3836290634886429689-o.webp",
  "/optimized-assets/project-web/39e5bdaff03f-27dec-rnb-2.webp",
  "/optimized-assets/project-web/fec395da172e-53833614-1056930751166016-7592783103018401792-o.webp",
  "/optimized-assets/project-web/d823e4538f8e-addicted-to-music.webp",
  "/optimized-assets/project-web/5c3b534b05ff-nye-flyer-2.webp",
]);
---

<Layout
  locale={locale}
  title={`${copy.metaTitle} | d . media`}
  description={copy.metaDescription}
  path="/projects"
  structuredData={[getBreadcrumbSchema({ locale, path: "/projects", title: copy.metaTitle })]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro page-intro-balanced">
        <h1><BrandText text={copy.title} /></h1>
        <p class="page-text">{copy.text}</p>
      </div>
      <div class="showcase-grid project-reading-grid">
        <article class="card package-card">
          <h3>{copy.readingTitle}</h3>
          <p>{copy.readingText}</p>
        </article>
        <article class="card package-card">
          <h3>{copy.resultTitle}</h3>
          <p>{copy.resultText}</p>
        </article>
      </div>

      <div class="section-heading page-subheading">
        <h2>{copy.selectedTitle}</h2>
        <p class="page-text">{copy.selectedText}</p>
      </div>
      <div class="showcase-grid projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>

      <div class="section-heading page-subheading">
        <h2>{copy.archiveTitle}</h2>
        <p class="page-text">{copy.archiveText}</p>
      </div>
      <div class="archive-grid">
        {archiveProjects.map((project) => (
          <ProjectCard project={project} locale={locale} variant="archive" />
        ))}
      </div>

      {legacyMockupCollections.map((collection) => (
        <section class="legacy-mockup-section">
          <div class="section-heading page-subheading">
            <h2>{collection.title}</h2>
            <p class="page-text">{collection.description}</p>
          </div>
          <div class="legacy-mockup-grid">
            {collection.items.map((item) => (
              <a
                class={`card legacy-mockup-card gallery-trigger legacy-mockup-trigger ${
                  portraitLegacyMockupPaths.has(item.src) ? "legacy-mockup-card-portrait" : "legacy-mockup-card-landscape"
                }`}
                href={item.src}
                data-gallery-trigger
                data-gallery-alt={item.alt}
              >
                <div class="legacy-mockup-frame">
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <article class="card projects-cta-card">
        <div class="services-cta-copy">
          <h2>{copy.ctaTitle}</h2>
          <p class="page-text"><BrandText text={copy.ctaText} /></p>
        </div>
        <div class="hero-actions">
          <a
            href={localizeHref(locale, "/contact")}
            class="button button-primary"
            data-ga-event="cta_start_project_click"
            data-ga-location="projects_cta"
          >
            {copy.primaryCta}
          </a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">
            {copy.secondaryCta}
          </a>
        </div>
      </article>
    </section>
  </main>
</Layout>
