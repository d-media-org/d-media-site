---
import BrandText from "@/components/BrandText.astro";
import MotionArchiveSections from "@/components/MotionArchiveSections.astro";
import Layout from "@/layouts/Layout.astro";
import { getResolvedAllProjectsArchive } from "@/lib/asset-url";
import { localizeHref, type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getProjectBreadcrumbSchema, getProjectCreativeWorkSchema } from "@/lib/seo";
import { getSiteContent } from "@/lib/site-content";
import { getUiCopy } from "@/lib/ui-copy";

export function getStaticPaths() {
  return getResolvedAllProjectsArchive("bg").map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const locale: Locale = "bg";
const { project } = Astro.props;
const isCaseStudy = "isCaseStudy" in project && project.isCaseStudy;
const copy = getPageCopy(locale).projectDetail;
const siteContent = getSiteContent(locale);
const ui = getUiCopy(locale);
const caseStudySections = isCaseStudy && "caseStudySections" in project ? project.caseStudySections : [];
const projectVideos = "videos" in project ? project.videos : [];
const projectLinks = "links" in project ? project.links : [];
const projectSubtitle = "subtitle" in project ? project.subtitle : null;
const projectType = "projectType" in project ? project.projectType : null;
const projectStatus = "status" in project ? project.status : null;
const projectHeroImage = "detailCover" in project ? project.detailCover : project.cover;
const projectSocialImage = projectHeroImage.startsWith("http") ? projectHeroImage : `https://www.d-media.org${projectHeroImage}`;
const projectGalleryImages = project.images.filter(
  (image: { src: string }, index: number, images: { src: string }[]) =>
    image.src !== projectHeroImage && images.findIndex((entry) => entry.src === image.src) === index,
);
type ProjectImage = { src: string; label?: string };
type ProjectGalleryGroup = { pairKey: string | null; images: ProjectImage[] };
const getBusinessCardPairKey = (image: ProjectImage) => {
  const source = `${image.src} ${image.label ?? ""}`.toLowerCase();
  if (!/\b(front|back)\b/.test(source)) return null;

  return image.src
    .split("/")
    .at(-1)
    ?.replace(/^\d+[-_]/, "")
    .replace(/[-_](?:business[-_]?cards?[-_]?)?(?:front|back)(?=\.[^.]+$)/i, "")
    .replace(/\.[^.]+$/, "") ?? null;
};
const projectGalleryGroups = projectGalleryImages.reduce<ProjectGalleryGroup[]>((groups, image: ProjectImage) => {
  const pairKey = getBusinessCardPairKey(image);
  const existingGroup = pairKey ? groups.find((group) => group.pairKey === pairKey) : undefined;

  if (existingGroup) {
    existingGroup.images.push(image);
  } else {
    groups.push({ pairKey, images: [image] });
  }

  return groups;
}, []);
const hasProjectFiles = projectGalleryImages.length > 0;
const formatFileCount = (count: number) =>
  locale === "en" ? `${count} ${count === 1 ? "file" : "files"}` : `${count} ${count === 1 ? "файл" : "файла"}`;
const relatedServiceIdsByProject: Record<string, string[]> = {
  "d-media": ["brand-identity", "web-design-development", "content"],
  "apple-community-bulgaria": ["brand-identity", "content", "social-media-management"],
  yanita: ["brand-identity", "content", "graphic-design"],
  "support-account": ["brand-identity", "web-design-development", "graphic-design"],
  "support-account-group": ["brand-identity", "web-design-development", "graphic-design"],
  "dj-nedi": ["graphic-design", "social-media-management", "advertising"],
};
const selectableServices = siteContent.coreServices.filter((service) => service.id !== "additional-charges-rights");
const relatedServiceIds = relatedServiceIdsByProject[project.slug] ?? [
  "brand-identity",
  "graphic-design",
  "content",
];
const relatedServices = relatedServiceIds
  .map((id) => selectableServices.find((service) => service.id === id))
  .filter((service): service is (typeof selectableServices)[number] => service !== undefined);
---

<Layout
  locale={locale}
  title={`${project.title} ${isCaseStudy ? "казус" : "проект"} | d . media`}
  description={`${project.summary} ${project.context}`.trim()}
  path={`/projects/${project.slug}`}
  socialImage={projectSocialImage}
  structuredData={[
    getProjectCreativeWorkSchema({
      locale,
      slug: project.slug,
      title: project.title,
      description: `${project.summary} ${project.context}`.trim(),
      image: projectHeroImage,
      keywords: [project.title, ...project.focus],
    }),
    getProjectBreadcrumbSchema({ locale, slug: project.slug, title: project.title }),
  ]}
>
  <main class="site-shell" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1>{project.title}</h1>
        {projectSubtitle ? <p class="project-case-subtitle">{projectSubtitle}</p> : null}
        {projectType || projectStatus ? (
          <dl class="project-case-meta" aria-label="Данни за проекта">
            {projectType ? <div><dt>Тип</dt><dd>{projectType}</dd></div> : null}
            {projectStatus ? <div><dt>Статус</dt><dd>{projectStatus}</dd></div> : null}
          </dl>
        ) : null}
      </div>

      <article class="card case-study-hero">
        <div class="showcase-image case-study-image">
          <div class="case-study-image-frame">
            <img src={projectHeroImage} alt={project.title} loading="eager" decoding="async" />
          </div>
        </div>
        <div class="case-study-body">
          <div class="case-study-section">
            <h2 class="case-study-label">{copy.context}</h2>
            <p>{project.context}</p>
          </div>
          <div class="case-study-section">
            <h2 class="case-study-label">{copy.solution}</h2>
            <p>{project.summary}</p>
          </div>
          <div class="case-study-section">
            <h2 class="case-study-label">{copy.usage}</h2>
            <ul class="detail-list">
              {project.focus.map((detail: string) => (
                <li>{detail}</li>
              ))}
            </ul>
          </div>
          {caseStudySections.map((section: { title: string; text: string }) => (
            <div class="case-study-section">
              <h2 class="case-study-label">{section.title}</h2>
              <p><BrandText text={section.text} /></p>
            </div>
          ))}
          {hasProjectFiles ? (
            <div class="case-study-section">
              <h2 class="case-study-label">{copy.archive}</h2>
              <div class="tag-list">
                <span class="tag-pill">{formatFileCount(projectGalleryImages.length)}</span>
                <span class="tag-pill">{project.featured ? ui.featuredProject : ui.archiveProject}</span>
              </div>
            </div>
          ) : null}
          {project.slug === "d-media" ? (
            <div class="case-study-section">
              <h2 class="case-study-label">Развитие</h2>
              <p>Виж хронологията на решенията, миграциите и системните подобрения по сайта.</p>
              <a class="inline-link" href="/site-history/">История на сайта</a>
            </div>
          ) : null}
          {projectLinks.map((link: { href: string; label: string; title?: string; text?: string }) => (
            <div class="case-study-section">
              {link.title ? <h2 class="case-study-label">{link.title}</h2> : null}
              {link.text ? <p>{link.text}</p> : null}
              <a class="inline-link" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </div>
          ))}
          <div class="project-card-footer">
            <span class="project-meta">{copy.meta}</span>
            <a class="inline-link" href={localizeHref(locale, "/projects")}>{copy.back}</a>
          </div>
        </div>
      </article>

      {hasProjectFiles ? (
        <>
          <div class="section-heading page-subheading">
            <h2>{copy.applicationsTitle}</h2>
          </div>
          <div class="mockup-grid projects-gallery">
            {projectGalleryGroups.map((group) => group.pairKey && group.images.length > 1 ? (
              <div class="project-card-pair">
                <p class="project-card-pair-label">Визитка — лице и гръб</p>
                <div class="project-card-pair-grid">
                  {group.images.map((image) => (
                    <a
                      class="card mockup-card project-png-card gallery-trigger project-file-trigger"
                      href={image.src}
                      data-gallery-trigger
                      data-gallery-alt={image.label ?? project.title}
                    >
                      <div class="mockup-image">
                        <img src={image.src} alt={image.label ?? project.title} decoding="async" />
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ) : group.images.map((image) => (
              <a
                class="card mockup-card project-png-card gallery-trigger project-file-trigger"
                href={image.src}
                data-gallery-trigger
                data-gallery-alt={image.label ?? project.title}
              >
                <div class="mockup-image">
                  <img src={image.src} alt={image.label ?? project.title} decoding="async" />
                </div>
              </a>
            )))}
          </div>
        </>
      ) : null}

      {project.slug === "d-media" ? <MotionArchiveSections locale={locale} /> : null}

      {projectVideos.length ? (
        <>
          <div class="section-heading page-subheading">
            <h2>Motion приложение</h2>
          </div>
          <div class="mockup-grid projects-gallery">
            {projectVideos.map((video: { src: string; poster: string; label: string }) => (
              <article class="card mockup-card project-png-card">
                <div class="mockup-image">
                  <video controls playsinline preload="metadata" poster={video.poster} aria-label={video.label}>
                    <source src={video.src} type="video/mp4" />
                  </video>
                </div>
              </article>
            ))}
          </div>
        </>
      ) : null}

      <div class="section-heading page-subheading">
        <h2>Свързани направления</h2>
      </div>
      <div class="showcase-grid service-card-grid">
        {relatedServices.map((service) => (
          <article class="card service-category-card">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="inline-link" href={localizeHref(locale, service.detailHref)}>
              {service.detailLabel}
            </a>
          </article>
        ))}
      </div>

      <article class="card services-cta-card">
        <div class="services-cta-copy">
          <h2>Ако търсиш подобен обхват, започни с кратък контекст.</h2>
          <p class="page-text">Опиши проекта, нужния резултат и срока. Оттам подреждаме подход, обхват и следваща стъпка.</p>
        </div>
        <div class="hero-actions">
          <a
            href={localizeHref(locale, "/contact")}
            class="button button-primary"
            data-ga-event="cta_start_project_click"
            data-ga-location="project_detail_cta"
          >
            Изпрати проектен контекст
          </a>
          <a href={localizeHref(locale, "/services")} class="button button-secondary">
            Разгледай услугите
          </a>
        </div>
      </article>
    </section>
  </main>
</Layout>
