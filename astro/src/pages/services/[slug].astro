---
import ServiceDetailPage from "@/components/ServiceDetailPage.astro";
import { getAuthorityServices } from "@/lib/authority-services";

export function getStaticPaths() {
  return getAuthorityServices("bg").map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const path = `/services/${service.slug}`;
---

<ServiceDetailPage locale="bg" path={path} copy={service} ctaLocation={`${service.slug}_service_cta`} />
