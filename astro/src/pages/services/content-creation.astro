---
import ServiceDetailPage from "@/components/ServiceDetailPage.astro";
import { type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";

const locale: Locale = "bg";
const baseCopy = getPageCopy(locale).contentService;
const copy = {
  ...baseCopy,
  metaTitle: "Създаване на съдържание",
  metaDescription:
    "Създаване на съдържание за брандове: текстове, визуални формати, серия от публикации, съдържателна структура и ясна комуникационна линия.",
  title: "Създаване на съдържание",
  intro:
    "Създаваме и редактираме съдържание за сайтове, социални мрежи, кампании и други комуникационни канали — текстово, визуално, аудио, видео или комбинирано.",
  sections: [
    { title: "Какво може да включва", text: "Текстове за сайтове, описания на услуги и продукти, статии, казуси, често задавани въпроси, рекламни текстове, публикации за социални мрежи, сценарии, графични формати, аудио, видео и редакция на съществуващо съдържание." },
    { title: "Първо целта, после форматът", text: "Първо определяме каква работа трябва да извърши съдържанието: да обясни, да представи, да квалифицира, да убеди, да подпомогне търсенето или да поддържа редовна комуникация. След това избираме подходящите формати." },
    { title: "SEO и GEO съдържание", text: "Когато SEO или GEO са част от целта, подреждаме съдържанието така, че да е ясно за хора, търсачки и системи с изкуствен интелект, без да обещаваме конкретно класиране или цитиране." },
  ],
  faqs: [
    { question: "Може ли да работите само върху текст?", answer: "Да. Обхватът може да бъде само текстов, визуален, аудио, видео или комбиниран." },
    { question: "Може ли да редактирате вече написано съдържание?", answer: "Да. Преглеждаме наличния материал и уговаряме нужната редакция според целта и източниците." },
    { question: "Проверявате ли фактите?", answer: "Проверяваме информацията според договорения обхват и наличните източници. Клиентът остава отговорен за точността на предоставената вътрешна информация." },
  ],
  pricingTitle: "Начални рамки за съдържателен обхват.",
  pricingText:
    "Съдържателният обхват се подрежда според брой формати, текстова работа, визуална серия и нужната честота. Социалните визуални формати по-долу дават начална рамка за първи работен обхват.",
  ctaTitle: "Ако съдържанието трябва да звучи и изглежда последователно, започни оттук.",
  ctaText:
    "Изпрати канали, теми, нужни формати, честота и налични материали. Оттам подреждаме съдържателния обхват.",
  primaryCta: "Опиши проекта",
};
const path = "/services/content-creation";
---

<ServiceDetailPage locale={locale} path={path} copy={copy} ctaLocation="content_creation_service_cta" />
