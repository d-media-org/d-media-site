---
import ServiceDetailPage from "@/components/ServiceDetailPage.astro";
import { type Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";

const locale: Locale = "bg";
const baseCopy = getPageCopy(locale).contentService;
const copy = {
  ...baseCopy,
  metaTitle: "Управление на социални медии",
  metaDescription:
    "Управление на социални медии за брандове: визуална линия, формати, последователност, календар и работна структура за публикуване.",
  title: "Управление на социални медии",
  intro:
    "Планираме и поддържаме присъствието на бранда в социалните канали според реалния работен ритъм — от съдържанието и публикуването до наблюдението и отчетността.",
  sections: [
    { title: "Какво може да включва", text: "Съдържателна посока, календар за публикации, текстове, графични материали, видео и адаптации, публикуване, модериране, комуникация с аудиторията, наблюдение, периодични отчети и консултации." },
    { title: "Платформи", text: "Работим с Facebook, Instagram, Threads, LinkedIn, TikTok, YouTube и други канали според проекта и реалната роля на всеки канал." },
    { title: "Месечният обхват", text: "Определя се според броя канали, честотата на публикуване, количеството съдържание, нуждата от модериране и наличните материали. Не гарантираме последователи, гледания или продажби." },
  ],
  faqs: [
    { question: "Включва ли услугата публикуване?", answer: "Когато публикуването е част от договорения месечен обхват." },
    { question: "Включва ли модериране?", answer: "Модерирането и комуникацията с аудиторията се уговарят според каналите, натоварването и нужния тон." },
    { question: "Гарантирате ли резултати?", answer: "Не. Можем да планираме, създаваме, публикуваме и оптимизираме комуникацията, но резултатите зависят и от продукта, аудиторията, бюджета и платформата." },
  ],
  pricingTitle: "Начални рамки за социално присъствие.",
  pricingText:
    "Началните рамки покриват визуални формати и серии за социални мрежи. Планиране, календар и публикуване се уточняват според честота, обем и работен режим.",
  ctaTitle: "Ако социалните канали трябва да работят като система, започни оттук.",
  ctaText:
    "Изпрати каналите, нужната честота, текущото състояние и формати. Оттам подреждаме реалния обхват за управление.",
  primaryCta: "Опиши проекта",
};
const path = "/services/social-media-management";
---

<ServiceDetailPage locale={locale} path={path} copy={copy} ctaLocation="social_media_management_service_cta" />
