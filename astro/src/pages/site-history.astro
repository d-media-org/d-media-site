---
import Layout from "@/layouts/Layout.astro";

const sections = [
  ["Начало на платформата", "Сайтът започва като представителна среда с основни страници и първоначално портфолио. Той събира на едно място информацията за бранда, услугите и извършената работа."],
  ["Развитие на структурата", "Платформата се разширява с отделни страници за услуги, ценови рамки и пътища за запитване. Информацията се подрежда така, че посетителят да може да премине от общ преглед към конкретно направление."],
  ["Работа и знания", "Към проектите и казусите се добавят двуезични статии и база знания. Така сайтът представя както визуалната работа, така и практическото съдържание около нея."],
  ["Технологична еволюция", "Публичната платформа преминава към Astro и статично генерирани страници. Това е архитектурен етап в развитието на сайта, а не гаранция за конкретни резултати."],
  ["Astro и Cloudflare Pages", "Текущият сайт се изгражда с Astro и се публикува чрез Cloudflare Pages. Отделени са средите за предварителен преглед и публично публикуване."],
  ["Производителност и качество", "По-ранната проектна документация записва оценки 98 / 100 / 100 / 100 за мобилни устройства и 100 / 100 / 100 / 100 за настолни устройства. Няма датиран първичен отчет; стойностите не са текущо измерване и не представляват постоянна гаранция."],
  ["SEO, GEO и AI видимост", "Съдържанието и техническата структура са развити с канонични адреси, езикови връзки, структурирани данни, карта на сайта и машинночетими файлове. Тези решения не гарантират позиции в търсачки или цитиране от AI системи."],
  ["Текущо състояние", "Днес d-media.org е двуезична платформа за представяне на услугите, проектите и казусите, началните ценови рамки, публикациите, базата знания и запитванията. Платформата продължава да се развива около тази съдържателна структура."],
] as const;
---

<Layout
  locale="bg"
  title="История на платформата | d . media"
  description="Етапите в развитието на d-media.org като публична дигитална платформа."
  path="/site-history"
  alternateLinks={{ en: "https://www.d-media.org/en/site-history/", xDefault: "https://www.d-media.org/site-history/" }}
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>История на платформата</h1>
        <p class="page-text">Етапи в развитието на d-media.org — отделно от историята на бранда и от вътрешния дневник на промените.</p>
        <p class="page-text history-version-switch">
          <a class="inline-link is-active" href="/site-history/">Обобщен преглед</a>
          <a class="inline-link" href="/site-history/daily/">Разширен преглед</a>
        </p>
      </header>
      <nav class="card history-index history-index-static" aria-label="Съдържание">
        <ul>{sections.map(([title], index) => <li><a href={`#stage-${index + 1}`}>{title}</a></li>)}</ul>
      </nav>
      <article class="card text-card history-content is-revealed">
        {sections.map(([title, text], index) => (
          <section class="history-stage">
            <h2 id={`stage-${index + 1}`}>{title}</h2>
            <p>{text}</p>
          </section>
        ))}
      </article>
    </section>
  </main>
</Layout>
