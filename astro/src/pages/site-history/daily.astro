---
import Layout from "@/layouts/Layout.astro";
import dailySource from "../../../../SITE_HISTORY_DAILY.md?raw";

type HistoryBlock =
  | { type: "heading"; level: 2 | 3 | 4; text: string; id: string }
  | { type: "paragraph"; text: string }
  | { type: "list"; items: string[] };

const inlineMarkup = (text: string) =>
  text
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");

const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/`/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, "-")
    .replace(/^-|-$/g, "");

const lines = dailySource.split(/\r?\n/);
const blocks: HistoryBlock[] = [];
let paragraph: string[] = [];
let listItems: string[] = [];

const flushParagraph = () => {
  if (!paragraph.length) return;
  blocks.push({ type: "paragraph", text: inlineMarkup(paragraph.join(" ")) });
  paragraph = [];
};

const flushList = () => {
  if (!listItems.length) return;
  blocks.push({ type: "list", items: listItems.map(inlineMarkup) });
  listItems = [];
};

for (const line of lines.slice(1)) {
  const heading = line.match(/^(#{2,4})\s+(.+)$/);
  const listItem = line.match(/^\s*-\s+(.+)$/);

  if (heading) {
    flushParagraph();
    flushList();
    const text = heading[2].replace(/`/g, "");
    blocks.push({
      type: "heading",
      level: heading[1].length as 2 | 3 | 4,
      text,
      id: slugify(text),
    });
    continue;
  }

  if (listItem) {
    flushParagraph();
    listItems.push(listItem[1]);
    continue;
  }

  if (!line.trim()) {
    flushParagraph();
    flushList();
    continue;
  }

  flushList();
  paragraph.push(line.trim());
}

flushParagraph();
flushList();

const timelineHeadings = blocks.filter(
  (block): block is Extract<HistoryBlock, { type: "heading" }> =>
    block.type === "heading" && block.level === 2,
);
---

<Layout
  locale="bg"
  title="История на сайта - ден по ден | d . media"
  description="Дневна хронология на промените по d . media с кратки записи по дати."
  path="/site-history/daily"
  alternateLinks={{ en: "https://www.d-media.org/en/site-history/daily/", xDefault: "https://www.d-media.org/site-history/daily/" }}
>
  <main class="site-shell history-page" id="top">
    <section class="section-grid">
      <header class="section-heading page-intro">
        <h1>История на сайта</h1>
        <p class="page-text">
          <a class="inline-link" href="/site-history/">Обобщената версия</a> остава за широкия преглед, а тази страница пази кратки записи ден по ден.
        </p>
        <p class="page-text history-version-switch">
          <a class="inline-link" href="/site-history/">Обобщена версия</a>
          <a class="inline-link is-active" href="/site-history/daily/">Дневна версия</a>
        </p>
      </header>

      <article class="card text-card history-content is-revealed">
        {blocks.map((block) => {
          if (block.type === "heading") {
            const Tag = `h${block.level}` as "h2" | "h3" | "h4";
            return <Tag id={block.id}>{block.text}</Tag>;
          }
          if (block.type === "list") {
            return <ul class="detail-list">{block.items.map((item) => <li set:html={item} />)}</ul>;
          }
          return <p set:html={block.text} />;
        })}
      </article>
    </section>
  </main>
</Layout>
