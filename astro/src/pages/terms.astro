---
import BrandText from "@/components/BrandText.astro";
import LegalSourceText from "@/components/LegalSourceText.astro";
import termsPolicyBg from "@/content/legal/terms-bg.txt?raw";
import Layout from "@/layouts/Layout.astro";
import type { Locale } from "@/lib/i18n";
import { getPageCopy } from "@/lib/page-copy";
import { getSiteContent } from "@/lib/site-content";

const locale: Locale = "bg";
const copy = getPageCopy(locale).terms;
const siteContent = getSiteContent(locale);
---

<Layout locale={locale} title={`${copy.metaTitle} | d . media`} description={copy.metaDescription} path="/terms">
  <main class="site-shell terms-page" id="top">
    <section class="section-grid">
      <div class="section-heading page-intro">
        <h1><BrandText text={copy.title} /></h1>
        <p class="page-text"><BrandText text={copy.text} /></p>
      </div>

      <div class="terms-layout">
        <div class="terms-short">
          <section class="terms-block card terms-short-card terms-short-primary">
            <ul class="terms-summary-list">
              {siteContent.termsSummary.map((item) => (
                <li><BrandText text={item} /></li>
              ))}
            </ul>
          </section>

          <div class="terms-summary-grid">
            {siteContent.termsSections.map((section) => (
              <section class="terms-block card terms-short-card">
                <h2>{section.title}</h2>
                <p><BrandText text={section.text} /></p>
              </section>
            ))}
          </div>
        </div>

        <details class="card privacy-details">
          <summary>{copy.fullLabel}</summary>
          <div class="privacy-details-copy">
            <LegalSourceText source={termsPolicyBg} />
          </div>
        </details>
      </div>

      <div class="project-card-footer">
        <a class="inline-link" href="/legal/policies/">Оперативни политики</a>
      </div>
    </section>
  </main>
</Layout>
