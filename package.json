{
  "name": "d-media-site",
  "description": "d . media - site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:cache": "eslint --cache --cache-location .eslintcache",
    "check": "npm run build && npm run lint:cache",
    "assets:web": "node scripts/generate-web-assets.mjs",
    "blob:audit": "env -u VERCEL_OIDC_TOKEN node --env-file=.env.local scripts/audit-blob-assets.mjs",
    "sync:blob": "env -u VERCEL_OIDC_TOKEN node --env-file=.env.local scripts/sync-blob-assets.mjs",
    "ship": "npm run check && npx vercel --prod --yes"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-icons": "^16.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
